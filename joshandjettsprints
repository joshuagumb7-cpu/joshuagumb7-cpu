                  <button type="button" onclick="setFilamentColor('#ef4444')" class="w-6 h-6 rounded-lg border border-slate-700" style="background:#ef4444"></button>
                  <button type="button" onclick="setFilamentColor('#ffffff')" class="w-6 h-6 rounded-lg border border-slate-700" style="background:#ffffff"></button>
