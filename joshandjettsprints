    window.submitNewFilament = async function() {
      const id = document.getElementById('edit-filament-id').value;
      const name = document.getElementById('new-filament-name').value.trim();
      const desc = document.getElementById('new-filament-desc').value.trim();
      const color = document.getElementById('new-filament-color').value;
      const surcharge = parseInt(document.getElementById('new-filament-surcharge').value) || 0;
      if (!name) { showToast('Enter filament name.', 'error'); return; }
      if (id) {
        const f = filamentMap.get(id);
        if (f) {
          f.name = name; f.color = color; f.surcharge = surcharge; f.description = desc;
          renderOwnerFilaments();
          await saveFilamentToDb(f);
          showToast('Updated: ' + name);
        }
      } else {
        const nf = { id: 'fil-' + Date.now(), name, color, surcharge, description: desc, inStock: true, sortOrder: filaments.length };
        filaments.push(nf); rebuildMaps(); renderOwnerFilaments();
        await saveFilamentToDb(nf);
        showToast('Added: ' + name);
      }
      closeAddFilamentModal();
    };
