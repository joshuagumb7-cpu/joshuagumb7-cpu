            <label class="text-slate-400 block mb-1">Price Surcharge (฿)</label>
            <input type="number" id="new-filament-surcharge" value="0" min="0" oninput="updateFilamentPreview()"
              class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-500" />
