          + '<div class="min-w-0 flex-1">'
          + '<span class="text-slate-200 font-bold filament-name">' + escapeHtml(f.name) + '</span>'
          + (f.description ? '<p class="text-[10px] text-slate-500 filament-name mt-0.5">' + escapeHtml(f.description) + '</p>' : '')
          + '</div></div>'
          + '<div class="filament-actions">'
          + '<button onclick="moveFilament(\'' + f.id + '\', -1)" ' + (first ? 'disabled' : '') + ' class="p-1 transition ' + (first ? 'text-slate-700 cursor-not-allowed' : 'text-slate-400 hover:text-cyan-400') + '"><i class="fa-solid fa-arrow-up"></i></button>'
          + '<button onclick="moveFilament(\'' + f.id + '\', 1)" ' + (last ? 'disabled' : '') + ' class="p-1 transition ' + (last ? 'text-slate-700 cursor-not-allowed' : 'text-slate-400 hover:text-cyan-400') + '"><i class="fa-solid fa-arrow-down"></i></button>'
