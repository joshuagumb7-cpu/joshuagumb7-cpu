          + '<button onclick="deleteFilament(\'' + f.id + '\')" class="text-slate-500 hover:text-rose-400 transition p-1"><i class="fa-solid fa-trash-can"></i></button>'
          + '</div></div>'
          + '<div class="flex items-center justify-between pt-2 border-t border-slate-800 gap-2 flex-wrap">'
          + '<span class="text-slate-400 text-[10px]">+฿' + f.surcharge + ' surcharge</span>'
          + '<button onclick="toggleFilamentStock(\'' + f.id + '\')" class="px-2.5 py-1 rounded-xl text-[10px] font-bold transition ' + (f.inStock ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30') + '">' + (f.inStock ? 'In Stock' : 'Out of Stock') + '</button>'
          + '</div></div>';
      }).join('');
    };
    window.moveFilament = async function(id, dir) {
      const i = filaments.findIndex(f => f.id === id); if (i === -1) return;
      const ni = i + dir; if (ni < 0 || ni >= filaments.length) return;
      [filaments[i], filaments[ni]] = [filaments[ni], filaments[i]];
      filaments.forEach((f, idx) => f.sortOrder = idx);
      renderOwnerFilaments();
      try { await bulkWrite(COL_FILAMENTS, filaments.map(f => ({ ...f })), f => f.id); } catch (e) {}
    };

