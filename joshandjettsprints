      try {
        const raw = localStorage.getItem('jj_cart_v1');
        if (raw) cart = JSON.parse(raw) || [];
      } catch(e) { cart = []; }
    }
    window.updateCartBadge = function() {
      const badge = document.getElementById('cart-badge');
      const totalItems = cart.reduce((s, i) => s + (i.qty || 1), 0);
      if (!badge) return;
      if (totalItems > 0) { badge.classList.remove('empty'); badge.innerText = totalItems > 99 ? '99+' : String(totalItems); }
      else { badge.classList.add('empty'); badge.innerText = '0'; }
    };
    window.openCartModal = function() {
      document.getElementById('modal-cart').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      renderCartModal();
    };
    window.closeCartModal = function() {
      document.getElementById('modal-cart').classList.add('hidden');
      document.body.style.overflow = '';
    };
    function renderCartModal() {
      const container = document.getElementById('cart-items-container');
      const subtitle = document.getElementById('cart-subtitle');
      const totalEl = document.getElementById('cart-total');
      if (cart.length === 0) {
        container.innerHTML = '<div class="text-center py-16 space-y-3"><i class="fa-solid fa-cart-shopping text-5xl text-slate-700"></i><p class="text-sm font-mono text-slate-500">Your cart is empty.</p><p class="text-[11px] font-mono text-slate-600">Add models from the shop to see them here.</p></div>';
        subtitle.innerText = '0 items';
        totalEl.innerText = '฿0';
        return;
      }
      const totalItems = cart.reduce((s, i) => s + i.qty, 0);
      subtitle.innerText = totalItems + ' item' + (totalItems !== 1 ? 's' : '') + ' (one order)';
      const totalPrice = cart.reduce((s, i) => s + (i.unitPrice * i.qty), 0);
      totalEl.innerText = '฿' + totalPrice;
      container.innerHTML = cart.map(item => {
        const crop = item.imageCrop || defaultCrop();
        const thumb = item.imageUrl
          ? '<img src="' + escapeAttr(item.imageUrl) + '" style="object-position:' + (crop.x || 50) + '% ' + (crop.y || 50) + '%;transform:scale(' + ((crop.zoom || 100) / 100) + ');transform-origin:' + (crop.x || 50) + '% ' + (crop.y || 50) + '%;" />'
          : '<i class="fa-solid ' + (item.icon || 'fa-cube') + ' text-cyan-400/40 text-xl"></i>';
        const optsList = Object.keys(item.options || {}).map(k => escapeHtml(k) + ': <strong class="text-white">' + escapeHtml(item.options[k]) + '</strong>').join(' · ');
        return '<div class="cart-item">'
          + '<div class="cart-thumb">' + thumb + '</div>'
          + '<div class="flex-1 min-w-0">'
          + '<div class="font-bold text-white text-sm truncate">' + escapeHtml(item.title) + '</div>'
          + '<div class="text-[10px] font-mono text-slate-400 mt-0.5 flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background:' + item.filamentColor + '"></span> ' + escapeHtml(item.filamentName) + ' · ' + item.scale + '%</div>'
          + (optsList ? '<div class="text-[10px] font-mono text-cyan-300 mt-0.5 truncate">' + optsList + '</div>' : '')
          + '<div class="text-emerald-400 font-mono font-black text-sm mt-1">฿' + (item.unitPrice * item.qty) + '</div>'
          + '</div>'
          + '<div class="flex flex-col items-end gap-2">'
          + '<div class="flex items-center gap-1.5">'
          + '<button class="qty-btn" onclick="updateCartQty(\'' + item.cartId + '\', -1)">−</button>'
          + '<span class="font-mono text-xs text-white px-1">' + item.qty + '</span>'
          + '<button class="qty-btn" onclick="updateCartQty(\'' + item.cartId + '\', 1)">+</button>'
          + '</div>'
          + '<button onclick="removeFromCart(\'' + item.cartId + '\')" class="text-rose-400 hover:text-rose-300 text-[10px] font-mono transition"><i class="fa-solid fa-trash-can"></i></button>'
          + '</div>'
          + '</div>';
      }).join('');
    }
    window.updateCartQty = function(cartId, delta) {
      const it = cart.find(i => i.cartId === cartId); if (!it) return;
      it.qty = Math.max(1, Math.min(99, it.qty + delta));
      saveCart(); renderCartModal(); updateCartBadge(); renderOwnerCartTable();
    };
    window.removeFromCart = function(cartId) {
      cart = cart.filter(i => i.cartId !== cartId);
      saveCart(); renderCartModal(); updateCartBadge(); renderOwnerCartTable();
    };
    window.clearCart = function() {
      if (cart.length === 0) return;
      cart = []; saveCart(); renderCartModal(); updateCartBadge(); renderOwnerCartTable();
      showToast('Cart cleared.');
    };

    window.addCurrentConfigToCart = function() {
      if (!currentConfiguredModel) return;
      const scale = parseInt(document.getElementById('buy-scale-slider').value);
      const fil = filamentMap.get(selectedFilamentId);
      if (!fil || !fil.inStock) { showToast('Please select a valid in-stock filament.', 'error'); return; }
      const sm = Math.pow(scale / 100, 1.5);
      const optionsCost = getSelectedOptionsCost();
      const unitPrice = Math.round((currentConfiguredModel.price * sm) + fil.surcharge + optionsCost);
      const humanOpts = {};
      (currentConfiguredModel.options || []).forEach((g, gi) => {
        const gid = g.id || ('g' + gi);
        const v = selectedOptions[gid];
        if (v !== undefined) humanOpts[g.name || gid] = v;
      });
      cart.push({
        cartId: 'c-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
        modelId: currentConfiguredModel.id,
        title: currentConfiguredModel.title,
        icon: currentConfiguredModel.icon || 'fa-cube',
        imageUrl: currentConfiguredModel.imageUrl || '',
        imageCrop: currentConfiguredModel.imageCrop || defaultCrop(),
        filamentId: fil.id,
        filamentName: fil.name,
        filamentColor: fil.color,
        scale: scale,
        options: humanOpts,
        unitPrice: unitPrice,
        qty: 1
      });
      saveCart(); updateCartBadge(); renderOwnerCartTable();
      showToast('Added to cart: ' + currentConfiguredModel.title);
      closePurchaseModal();
    };

    window.checkoutCart = function() {
      if (cart.length === 0) { showToast('Cart is empty.', 'error'); return; }
      const savedName = localStorage.getItem('jj_last_name') || '';
      document.getElementById('checkout-name-input').value = savedName;
      clearFieldError('checkout-name-input');
      const totalQty = cart.reduce((s, i) => s + i.qty, 0);
      const totalPrice = cart.reduce((s, i) => s + (i.unitPrice * i.qty), 0);
      document.getElementById('checkout-summary-count').innerText = totalQty + ' piece' + (totalQty !== 1 ? 's' : '');
      document.getElementById('checkout-summary-total').innerText = '฿' + totalPrice;
      closeCartModal();
      document.getElementById('modal-checkout-name').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => document.getElementById('checkout-name-input').focus(), 100);
    };
    window.closeCheckoutNameModal = function() {
      document.getElementById('modal-checkout-name').classList.add('hidden');
      document.body.style.overflow = '';
    };

    window.submitCheckoutName = async function() {
      const nEl = document.getElementById('checkout-name-input');
      const customerName = nEl.value.trim();
      if (!customerName || customerName.length < 2) {
        showFieldError('checkout-name-input', 'Please enter at least 2 characters');
        nEl.focus();
        return;
      }
      localStorage.setItem('jj_last_name', customerName);
      closeCheckoutNameModal();

      const code = '8A' + Math.random().toString(36).substring(2, 8).toUpperCase();
      const printers = ['Bambu Lab A2L', 'Bambu Lab A1 Mini'];
      const printer = printers[Math.floor(Math.random() * printers.length)];
      const totalPrice = cart.reduce((s, i) => s + (i.unitPrice * i.qty), 0);
      const totalQty = cart.reduce((s, i) => s + i.qty, 0);

      const orderItems = [];
      cart.forEach(cartItem => {
        for (let q = 0; q < cartItem.qty; q++) {
          orderItems.push({
            title: cartItem.title,
            icon: cartItem.icon,
            filamentName: cartItem.filamentName,
            filamentColor: cartItem.filamentColor,
            scale: cartItem.scale,
            options: cartItem.options,
            unitPrice: cartItem.unitPrice
          });
        }
      });

      const uniqueTitles = [...new Set(cart.map(c => c.title))];
      const summaryTitle = uniqueTitles.length === 1
        ? uniqueTitles[0] + (totalQty > 1 ? ' ×' + totalQty : '')
        : uniqueTitles.length + ' models (' + totalQty + ' items)';

      const specsSummary = cart.map(c => c.title + ' ×' + c.qty + ' (' + c.filamentName + ', ' + c.scale + '%)').join(' | ');

      const newOrder = {
        trackingCode: code,
        customerName,
        modelTitle: summaryTitle,
        modelIcon: cart[0].icon || 'fa-cube',
        specs: specsSummary,
        printerName: printer,
        stage: 0,
        selectedOptions: {},
        items: orderItems,
        logs: [
          '▶ Order created for ' + customerName + ' (฿' + totalPrice + ') — ' + totalQty + ' item(s).',
          '▶ Assigned to physical machine: ' + printer + '.'
        ],
        createdAt: new Date().toISOString().replace('T', ' ').substring(0, 16)
      };

      orders.unshift(newOrder);
      try { await saveOrderToDb(newOrder); } catch (e) {}

      try {
        const myOrders = JSON.parse(localStorage.getItem('jj_my_orders_v1') || '[]');
        myOrders.push(code);
        localStorage.setItem('jj_my_orders_v1', JSON.stringify(myOrders.slice(-50)));
      } catch (e) {}

      rebuildMaps();
      cart = []; saveCart(); updateCartBadge(); renderOwnerCartTable();
      showToast('Order placed! Tracking Code: ' + code);
      viewOrderTracking(code);
      customerSync();
    };

