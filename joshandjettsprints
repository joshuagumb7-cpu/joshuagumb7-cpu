    window.renderCategoryPills = function() {
      const c = document.getElementById('category-pills-container'); if (!c) return;
      const cats = [
        { key: 'All', label: 'All', icon: 'fa-cube' },
        { key: 'New Arrivals', label: 'New Arrivals', icon: 'fa-star' },
        { key: 'Articulated', label: 'Articulated' },
        { key: 'Miniatures', label: 'Miniatures' },
        { key: 'Mechanical', label: 'Mechanical' },
        { key: 'Toys', label: 'Toys' },
        { key: 'Functional', label: 'Functional' },
        { key: 'Cosplay', label: 'Cosplay' },
        { key: 'Desk Decor', label: 'Desk Decor' },
        { key: 'Fidget', label: 'Fidget' },
        { key: 'Puzzles', label: 'Puzzles' }
      ];
      c.innerHTML = cats.map(cat => {
        const a = currentCategory === cat.key;
        const isNew = cat.key === 'New Arrivals';
        let cls;
        if (a && isNew) cls = 'bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 font-bold border-amber-400 shadow-lg shadow-amber-500/30';
        else if (a) cls = 'bg-cyan-500 text-slate-950 font-bold border-cyan-400 shadow-lg shadow-cyan-500/20';
        else if (isNew) cls = 'bg-amber-950/40 text-amber-300 border-amber-500/30 hover:border-amber-400/60';
        else cls = 'bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700';
        return '<button onclick="setCategory(\'' + cat.key + '\')" class="px-3.5 py-1.5 rounded-xl text-xs font-mono border transition flex-shrink-0 flex items-center gap-1.5 ' + cls + '">' + (cat.icon ? '<i class="fa-solid ' + cat.icon + '"></i> ' : '') + cat.label + '</button>';
      }).join('');
    };
    window.setCategory = function(cat) { currentCategory = cat; renderCategoryPills(); renderShopGrid(); };
    window.debounceRenderShopGrid = function() {
      if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => renderShopGrid(), 150);
    };
    window.renderShopGrid = function() {
      const g = document.getElementById('product-grid'); if (!g) return;
      const s = (document.getElementById('shop-search-input') || {}).value || '';
      const search = s.toLowerCase();
      const filtered = catalogModels.filter(m => {
        let mc;
        if (currentCategory === 'All') mc = true;
        else if (currentCategory === 'New Arrivals') mc = !!m.newArrival;
        else mc = m.category === currentCategory;
        return mc && (m.title + ' ' + (m.desc || '')).toLowerCase().includes(search);
      });
      if (filtered.length === 0) {
        g.innerHTML = '<div class="col-span-full py-16 text-center space-y-3 glass-panel rounded-3xl border border-slate-800"><i class="fa-solid ' + (currentCategory === 'New Arrivals' ? 'fa-star' : 'fa-cube') + ' text-4xl text-slate-600"></i><p class="text-sm font-mono text-slate-400">No 3D print models found.</p></div>';
        return;
      }
      g.innerHTML = filtered.map(model => {
        const optionsBadge = (model.options && model.options.length > 0)
          ? '<span class="absolute bottom-3 right-3 bg-cyan-500/90 text-slate-950 text-[9px] font-black font-mono px-2 py-1 rounded-lg shadow-lg z-10"><i class="fa-solid fa-sliders"></i> ' + model.options.length + ' OPTION' + (model.options.length > 1 ? 'S' : '') + '</span>' : '';
        const newBadge = model.newArrival ? '<span class="new-badge"><i class="fa-solid fa-star"></i> NEW</span>' : '';
        return '<div class="glass-card rounded-3xl overflow-hidden border border-slate-800 flex flex-col justify-between group' + (model.newArrival ? ' ring-1 ring-amber-500/30' : '') + '">'
          + '<div class="relative">' + buildImageTag(model) + '<span class="absolute top-3 left-3 bg-slate-950/90 backdrop-blur px-3 py-1 rounded-xl border border-slate-800 text-[10px] font-mono text-cyan-400 font-bold z-10">' + escapeHtml(model.category) + '</span>' + newBadge + optionsBadge + '</div>'
          + '<div class="p-6 space-y-3">'
          + '<div class="flex items-center gap-2"><div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-sm"><i class="fa-solid ' + (model.icon || 'fa-cube') + '"></i></div><h3 class="text-base font-bold text-white tracking-tight">' + escapeHtml(model.title) + '</h3></div>'
          + '<p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">' + escapeHtml(model.desc || '') + '</p></div>'
          + '<div class="p-6 pt-0 flex items-center justify-between mt-2"><div><span class="text-[10px] font-mono text-slate-500 block">BASE PRICE</span><span class="text-lg font-black text-cyan-400 font-mono">฿' + model.price + '</span></div>'
          + '<button onclick="openPurchaseModal(\'' + model.id + '\')" class="px-4 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-black transition shadow-md flex items-center gap-1.5"><i class="fa-solid fa-cart-shopping"></i> Order Print</button></div>'
