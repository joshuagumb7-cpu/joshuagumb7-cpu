    window.showToast = function(message, type = 'success') {
      const c = document.getElementById('toast-container'); if (!c) return;
      const t = document.createElement('div');
      const bg = type === 'success' ? 'bg-cyan-950/95 border-cyan-500/40 text-cyan-300' : 'bg-rose-950/95 border-rose-500/40 text-rose-300';
      const ic = type === 'success' ? 'fa-circle-check text-cyan-400' : 'fa-triangle-exclamation text-rose-400';
      t.className = 'glass-panel p-4 rounded-2xl border ' + bg + ' flex items-center gap-3 shadow-xl pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300 font-mono text-xs';
      t.innerHTML = '<i class="fa-solid ' + ic + ' text-base"></i><span class="flex-grow">' + message + '</span>';
      c.appendChild(t);
      setTimeout(() => t.classList.remove('translate-y-2', 'opacity-0'), 10);
      setTimeout(() => { t.classList.add('translate-y-2', 'opacity-0'); setTimeout(() => t.remove(), 300); }, 3000);
