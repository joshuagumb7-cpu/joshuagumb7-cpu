    // ============================================================
    // NAVIGATION
    // ============================================================
    window.navigateTo = function(viewName, updateHash = true) {
      if (viewName === 'owner') { openOwnerPinModal(); return; }
      if (updateHash) {
        const target = '#' + viewName;
        if (window.location.hash !== target) { window.location.hash = target; return; }
      }
      activeView = viewName;
      document.getElementById('view-shop').classList.add('hidden');
      document.getElementById('view-tracking').classList.add('hidden');
      document.getElementById('view-owner').classList.add('hidden');
      if (viewName === 'shop') { document.getElementById('view-shop').classList.remove('hidden'); renderShopGrid(); }
      else if (viewName === 'tracking') { document.getElementById('view-tracking').classList.remove('hidden'); }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };
    window.handleHashNavigation = function() {
      const h = window.location.hash.replace('#', '');
      if (h === 'tracking') {
        if (!activeTrackingCode && orders.length > 0) activeTrackingCode = orders[0].trackingCode;
        if (activeTrackingCode) viewOrderTracking(activeTrackingCode, false);
        else navigateTo('shop', false);
      } else if (h === 'owner') { navigateTo('shop', false); openOwnerPinModal(); }
      else navigateTo('shop', false);
    };
    window.addEventListener('hashchange', handleHashNavigation);
    window.exitOwnerPortal = function() { activeView = 'shop'; history.replaceState(null, '', '#shop'); navigateTo('shop', false); };

    function escapeHtml(str) { if (str == null) return ''; return String(str).replace(/[&<>"']/g, s => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[s])); }
    function escapeAttr(str) { return escapeHtml(str).replace(/"/g, '&quot;'); }

    function buildImageTag(model) {
      if (!model.imageUrl) {
        return '<div class="img-placeholder"><i class="fa-solid ' + (model.icon || 'fa-cube') + ' text-5xl text-cyan-400/40"></i></div>';
      }
      const c = model.imageCrop || defaultCrop();
      const aspect = c.aspect || '4/3';
      const style = 'object-position: ' + (c.x || 50) + '% ' + (c.y || 50) + '%; transform: scale(' + ((c.zoom || 100) / 100) + '); transform-origin: ' + (c.x || 50) + '% ' + (c.y || 50) + '%;';
      const imgSrcAttr = escapeAttr(model.imageUrl);
      return '<div class="product-img-wrap" style="aspect-ratio:' + aspect + ';" onclick="openLightbox(\'' + imgSrcAttr + '\')">'
        + '<img src="' + imgSrcAttr + '" alt="' + escapeAttr(model.title) + '" style="' + style + '" />'
        + '<div class="zoom-hint"><i class="fa-solid fa-magnifying-glass-plus text-white text-2xl"></i></div>'
        + '</div>';
    }

