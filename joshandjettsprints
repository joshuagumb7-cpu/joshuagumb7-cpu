    // ============================================================
    // PURCHASE MODAL
    // ============================================================
    window.openPurchaseModal = function(modelId) {
      const m = catalogMap.get(modelId); if (!m) return;
      currentConfiguredModel = m;
      selectedOptions = {};
      document.getElementById('buy-modal-name').innerText = m.title;
      document.getElementById('buy-modal-category').innerText = m.category;
      document.getElementById('buy-modal-desc').innerText = m.desc || '';
      document.getElementById('buy-modal-base-price').innerText = '฿' + m.price;
      const icon = document.getElementById('buy-modal-icon-box');
      if (m.imageUrl) icon.style.display = 'none';
      else { icon.style.display = 'flex'; icon.innerHTML = '<i class="fa-solid ' + (m.icon || 'fa-cube') + '"></i>'; }
      const heroImg = document.getElementById('buy-hero-image');
      const heroPh = document.getElementById('buy-hero-placeholder');
      if (m.imageUrl) {
        heroImg.src = m.imageUrl;
        heroImg.style.display = 'block';
        heroPh.style.display = 'none';
      } else {
        heroImg.style.display = 'none';
        heroPh.style.display = 'flex';
        heroPh.innerHTML = '<i class="fa-solid ' + (m.icon || 'fa-cube') + ' text-6xl text-cyan-400/40"></i>';
      }
      document.getElementById('buy-scale-slider').value = 100;
      document.getElementById('buy-scale-val').innerText = '100% (Standard)';
      document.getElementById('buy-customer-name').value = localStorage.getItem('jj_last_name') || '';
      clearFieldError('buy-customer-name');
      renderPurchaseModalFilamentChoices();
      renderPurchaseOptions();
      updateBuyTotal();
      document.getElementById('modal-purchase').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    function renderPurchaseOptions() {
      const section = document.getElementById('buy-options-section');
      const container = document.getElementById('buy-options-container');
      const opts = (currentConfiguredModel && currentConfiguredModel.options) || [];
      if (opts.length === 0) { section.classList.add('hidden'); container.innerHTML = ''; return; }
      section.classList.remove('hidden');
      container.innerHTML = opts.map((group, gi) => {
        const gid = group.id || ('g' + gi);
        const choices = group.choices || [];
        if (selectedOptions[gid] === undefined && choices.length > 0) {
          selectedOptions[gid] = choices[0].value !== undefined ? choices[0].value : choices[0];
        }
        const cur = selectedOptions[gid];
        return '<div class="space-y-2">'
          + '<div class="flex items-center justify-between"><span class="text-xs font-mono text-slate-300 font-bold">' + escapeHtml(group.name || 'Option') + '</span><span class="text-[10px] font-mono text-cyan-400">' + escapeHtml(cur || '—') + '</span></div>'
          + '<div class="flex flex-wrap gap-2">' + choices.map(c => {
              const val = c.value !== undefined ? c.value : c;
              const label = c.label !== undefined ? c.label : val;
              const delta = Number(c.priceDelta || c.surcharge || 0);
              const sel = cur === val;
              const pt = delta > 0 ? ' (+฿' + delta + ')' : '';
              return '<div data-option-group="' + escapeAttr(gid) + '" data-option-value="' + escapeAttr(val) + '" class="option-chip px-3 py-1.5 rounded-xl border text-xs font-mono transition cursor-pointer ' + (sel ? 'selected' : 'border-slate-800 bg-slate-900 text-slate-300 hover:border-slate-700') + '">' + escapeHtml(label) + '<span class="text-cyan-400/80 text-[10px]">' + pt + '</span></div>';
            }).join('') + '</div></div>';
      }).join('');
    }

    window.selectOption = function(gid, val) {
      if (selectedOptions[gid] === val) return;
      selectedOptions[gid] = val;
      renderPurchaseOptions();
      updateBuyTotal();
    };

    document.addEventListener('click', function(e) {
      const chip = e.target.closest('[data-option-group]');
      if (!chip) return;
      const purchaseModal = document.getElementById('modal-purchase');
      if (!purchaseModal || purchaseModal.classList.contains('hidden')) return;
      e.preventDefault();
      e.stopPropagation();
      const gid = chip.getAttribute('data-option-group');
      const val = chip.getAttribute('data-option-value');
      selectOption(gid, val);
    }, true);

    function renderPurchaseModalFilamentChoices() {
      const fc = document.getElementById('buy-filament-options'); if (!fc) return;
      if (filaments.length === 0) { fc.innerHTML = '<p class="col-span-full text-xs font-mono text-rose-400">No filaments available.</p>'; return; }
      if (!filamentMap.has(selectedFilamentId) || !filamentMap.get(selectedFilamentId).inStock) {
        const first = filaments.find(f => f.inStock);
        selectedFilamentId = first ? first.id : (filaments[0] ? filaments[0].id : null);
      }
      fc.innerHTML = filaments.map(f => {
        const sel = f.id === selectedFilamentId;
        const cls = sel ? 'border-cyan-500 bg-cyan-950/40 text-white' : 'border-slate-800 bg-slate-900 text-slate-400';
        const badge = f.inStock ? '<span class="text-[9px] text-cyan-300 ml-auto">+฿' + f.surcharge + '</span>' : '<span class="text-[9px] text-rose-400 ml-auto">[Out]</span>';
        const dis = f.inStock ? '' : 'opacity-50 pointer-events-none';
        return '<div onclick="' + (f.inStock ? "selectFilament('" + f.id + "')" : '') + '" class="p-2.5 rounded-xl border ' + cls + ' cursor-pointer transition flex items-center gap-2 text-xs font-mono ' + dis + '"><span class="w-3.5 h-3.5 rounded-full shadow-sm flex-shrink-0" style="background-color: ' + f.color + '"></span><span class="truncate">' + escapeHtml(f.name) + '</span>' + badge + '</div>';
      }).join('');
    }
    window.selectFilament = function(id) { selectedFilamentId = id; renderPurchaseModalFilamentChoices(); updateBuyTotal(); };

    function getSelectedOptionsCost() {
      if (!currentConfiguredModel || !currentConfiguredModel.options) return 0;
      let t = 0;
      currentConfiguredModel.options.forEach((g, gi) => {
        const gid = g.id || ('g' + gi);
        const val = selectedOptions[gid]; if (val === undefined) return;
        const c = (g.choices || []).find(x => (x.value !== undefined ? x.value : x) === val);
        if (c && c.priceDelta) t += Number(c.priceDelta);
      });
      return t;
    }

    window.updateBuyTotal = function() {
      if (!currentConfiguredModel) return;
      const scale = parseInt(document.getElementById('buy-scale-slider').value);
      document.getElementById('buy-scale-val').innerText = scale + '%';
      const fil = filamentMap.get(selectedFilamentId);
      const surcharge = fil ? fil.surcharge : 0;
      const sm = Math.pow(scale / 100, 1.5);
      const total = Math.round((currentConfiguredModel.price * sm) + surcharge + getSelectedOptionsCost());
      document.getElementById('buy-total-price').innerText = '฿' + total;
    };
    window.closePurchaseModal = function() {
      document.getElementById('modal-purchase').classList.add('hidden');
      document.body.style.overflow = '';
      clearFieldError('buy-customer-name');
    };

    window.confirmPurchaseOrder = async function() {
      if (!currentConfiguredModel) return;
      const nEl = document.getElementById('buy-customer-name');
      const name = nEl.value.trim();
      if (!name || name.length < 2) {
        showFieldError('buy-customer-name', 'Please enter at least 2 characters');
        showToast('Please enter a valid name (2+ characters).', 'error');
        nEl.focus();
        return;
      }
      localStorage.setItem('jj_last_name', name);
      const scale = document.getElementById('buy-scale-slider').value;
      const fil = filamentMap.get(selectedFilamentId) || filaments[0];
      if (!fil || !fil.inStock) { showToast('Please select a valid in-stock filament.', 'error'); return; }
      const code = '8A' + Math.random().toString(36).substring(2, 8).toUpperCase();
      const sm = Math.pow(scale / 100, 1.5);
      const finalPrice = Math.round((currentConfiguredModel.price * sm) + fil.surcharge + getSelectedOptionsCost());
      const printers = ['Bambu Lab A2L', 'Bambu Lab A1 Mini'];
      const printer = printers[Math.floor(Math.random() * printers.length)];
      const humanOpts = {};
      (currentConfiguredModel.options || []).forEach((g, gi) => {
        const gid = g.id || ('g' + gi);
        const v = selectedOptions[gid];
        if (v !== undefined) humanOpts[g.name || gid] = v;
      });
      const newOrder = {
        trackingCode: code, customerName: name,
        modelTitle: currentConfiguredModel.title,
        modelIcon: currentConfiguredModel.icon || 'fa-cube',
        specs: fil.name + ' | ' + scale + '% Scale (฿' + finalPrice + ')',
        printerName: printer, stage: 0, selectedOptions: humanOpts,
        items: [{
          title: currentConfiguredModel.title,
          icon: currentConfiguredModel.icon || 'fa-cube',
          filamentName: fil.name,
          filamentColor: fil.color,
          scale: scale,
          options: humanOpts,
          unitPrice: finalPrice
        }],
        logs: [
          '▶ Order created for ' + name + ' (฿' + finalPrice + ').',
          '▶ Filament selected: ' + fil.name + ' (+฿' + fil.surcharge + ').',
          '▶ Assigned to physical machine: ' + printer + '.'
        ],
        createdAt: new Date().toISOString().replace('T', ' ').substring(0, 16)
      };
      orders.unshift(newOrder); rebuildMaps();
      try {
        const myOrders = JSON.parse(localStorage.getItem('jj_my_orders_v1') || '[]');
        myOrders.push(code);
        localStorage.setItem('jj_my_orders_v1', JSON.stringify(myOrders.slice(-50)));
      } catch (e) {}
      closePurchaseModal();
      showToast('Order placed! Tracking Code: ' + code);
      viewOrderTracking(code);
      customerSync();
    };

    // ============================================================
    // TRACKING
    // ============================================================
    window.viewOrderTracking = function(code, updateHash = true) {
      const o = orderMap.get(code);
      if (!o) { showToast('Tracking code not found.', 'error'); return; }
      activeTrackingCode = code; activeView = 'tracking';
      if (updateHash && window.location.hash !== '#tracking') window.location.hash = '#tracking';
      document.getElementById('track-number-display').innerText = o.trackingCode;
      document.getElementById('track-item-title').innerHTML = '<i class="fa-solid ' + (o.modelIcon || 'fa-cube') + ' text-cyan-400 mr-1.5"></i> ' + escapeHtml(o.modelTitle);
      document.getElementById('track-item-specs').innerText = o.specs;
      const stages = ['Order Received', 'Printing in Progress', 'Inspected & Packaged', 'Ready for Pickup'];
      const st = Math.max(0, Math.min(3, o.stage));
      document.getElementById('current-status-title').innerText = stages[st];
      document.getElementById('progress-bar-fill').style.width = [0,33,66,100][st] + '%';
      for (let i = 0; i <= 3; i++) {
        const b = document.getElementById('node-blob-' + i);
        if (b) b.className = i <= st
          ? 'w-10 h-10 rounded-xl bg-cyan-500 text-slate-950 font-black border-2 border-cyan-400 flex items-center justify-center text-xs shadow-lg shadow-cyan-500/30 transition-all'
          : 'w-10 h-10 rounded-xl bg-slate-900 border-2 border-slate-700 flex items-center justify-center text-slate-500 text-xs font-bold transition-all';
      }
      const pickupWrap = document.getElementById('pickup-message-wrap');
      if (st >= 1) pickupWrap.classList.remove('hidden');
      else pickupWrap.classList.add('hidden');

      const itemsWrap = document.getElementById('track-items-wrap');
      const itemsList = document.getElementById('track-items-list');
      const items = o.items || [];
      if (items.length > 0) {
        itemsWrap.classList.remove('hidden');
        itemsList.innerHTML = items.map((it, i) =>
          '<div class="flex items-center gap-3 p-3 bg-slate-950/60 border border-slate-800 rounded-xl">'
          + '<span class="text-cyan-400 font-bold w-6 text-center">' + (i + 1) + '.</span>'
          + '<i class="fa-solid ' + (it.icon || 'fa-cube') + ' text-cyan-400"></i>'
          + '<div class="flex-1 min-w-0">'
          + '<div class="text-white font-bold truncate">' + escapeHtml(it.title) + '</div>'
          + '<div class="text-[10px] text-slate-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full" style="background:' + (it.filamentColor || '#64748b') + '"></span> ' + escapeHtml(it.filamentName || '') + ' · ' + (it.scale || 100) + '%'
          + (it.options && Object.keys(it.options).length > 0 ? ' · ' + Object.keys(it.options).map(k => escapeHtml(k) + '=' + escapeHtml(it.options[k])).join(', ') : '')
          + '</div></div>'
          + '<span class="text-emerald-400 font-bold">฿' + (it.unitPrice || 0) + '</span>'
          + '</div>'
        ).join('');
      } else {
        itemsWrap.classList.add('hidden');
        itemsList.innerHTML = '';
      }

      const ll = document.getElementById('audit-log-list');
      if (ll) ll.innerHTML = o.logs.map(l => '<li>' + escapeHtml(l) + '</li>').join('');
      const oSec = document.getElementById('track-selected-options');
      const oList = document.getElementById('track-selected-options-list');
      const so = o.selectedOptions || {};
      const keys = Object.keys(so);
      if (keys.length > 0 && items.length === 0) {
        oSec.classList.remove('hidden');
        oList.innerHTML = keys.map(k => '<span class="px-3 py-1.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300"><i class="fa-solid fa-circle-check text-[10px] mr-1"></i> ' + escapeHtml(k) + ': <strong class="text-white">' + escapeHtml(so[k]) + '</strong></span>').join('');
      } else { oSec.classList.add('hidden'); oList.innerHTML = ''; }
      document.getElementById('view-shop').classList.add('hidden');
      document.getElementById('view-tracking').classList.remove('hidden');
      document.getElementById('view-owner').classList.add('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };
    window.copyTrackingNumber = function() {
      if (!activeTrackingCode) return;
      const t = activeTrackingCode;
      if (navigator.clipboard && navigator.clipboard.writeText)
        navigator.clipboard.writeText(t).then(() => showToast('Copied ' + t)).catch(() => fallbackCopy(t));
      else fallbackCopy(t);
    };
    function fallbackCopy(text) {
      const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); showToast('Copied!'); } catch (e) { showToast('Copy failed.', 'error'); }
      document.body.removeChild(ta);
    }
    window.openQuickTrackModal = function() { document.getElementById('modal-quick-track').classList.remove('hidden'); };
    window.closeQuickTrackModal = function() { document.getElementById('modal-quick-track').classList.add('hidden'); };
    window.submitQuickTrack = function() {
      const c = document.getElementById('quick-track-input').value.trim().toUpperCase();
      if (!c) { showToast('Enter a valid code.', 'error'); return; }
      closeQuickTrackModal(); viewOrderTracking(c);
    };

