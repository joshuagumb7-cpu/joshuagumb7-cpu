        <div class="px-6 sm:px-8 py-4 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between gap-4 flex-shrink-0">
          <button onclick="closeAddFilamentModal()" class="px-5 py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-black uppercase tracking-wider transition">Cancel</button>
          <button onclick="submitNewFilament()" id="filament-submit-btn" class="px-6 sm:px-8 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-black text-xs uppercase tracking-wider transition shadow-lg shadow-amber-500/20 flex items-center gap-2">
            <i class="fa-solid fa-palette"></i> <span id="filament-submit-label">Add Filament</span>
          </button>
