      f.inStock = !f.inStock; renderOwnerFilaments();
      await saveFilamentToDb(f);
      showToast('Stock updated: ' + f.name);
    };
    window.deleteFilament = async function(id) {
      filaments = filaments.filter(f => f.id !== id);
      filaments.forEach((f, i) => f.sortOrder = i);
      rebuildMaps(); if (activeView === 'owner') renderOwnerFilaments();
      await removeFilamentFromDb(id);
      showToast('Filament removed.');
    };

    window.renderOwnerCatalog = function() {
      const c = document.getElementById('owner-catalog-container'); if (!c) return;
      c.innerHTML = catalogModels.map(m => {
        const c2 = m.imageCrop || defaultCrop();
        const img = m.imageUrl
          ? '<div class="product-img-wrap" style="aspect-ratio:' + (c2.aspect || '4/3') + ';"><img src="' + escapeAttr(m.imageUrl) + '" style="object-position:' + (c2.x || 50) + '% ' + (c2.y || 50) + '%;transform:scale(' + ((c2.zoom || 100) / 100) + ');transform-origin:' + (c2.x || 50) + '% ' + (c2.y || 50) + '%;" /></div>'
          : '<div class="w-full h-32 rounded-xl border border-slate-800 bg-slate-950 flex items-center justify-center"><i class="fa-solid ' + (m.icon || 'fa-cube') + ' text-3xl text-cyan-400/40"></i></div>';
        const oc = (m.options || []).length;
        const starBtn = '<button onclick="toggleNewArrival(\'' + m.id + '\')" class="absolute top-3 right-3 z-10 w-8 h-8 rounded-xl flex items-center justify-center transition ' + (m.newArrival ? 'bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/40' : 'bg-slate-950/80 text-slate-400 hover:text-amber-400 border border-slate-700') + '" title="Toggle New Arrival"><i class="fa-solid fa-star"></i></button>';
        return '<div class="glass-card rounded-2xl border ' + (m.newArrival ? 'border-amber-500/40' : 'border-slate-800') + ' flex flex-col justify-between space-y-3 overflow-hidden relative">'
          + '<div class="relative">' + img + starBtn + '</div>'
          + '<div class="p-4 space-y-1">'
          + '<h4 class="text-xs font-bold text-white flex items-center gap-2"><i class="fa-solid ' + (m.icon || 'fa-cube') + ' text-cyan-400"></i> ' + escapeHtml(m.title) + '</h4>'
          + '<span class="text-[10px] font-mono text-cyan-400 block">' + escapeHtml(m.category) + ' | ฿' + m.price + '</span>'
          + '<p class="text-[11px] text-slate-400 line-clamp-2">' + escapeHtml(m.desc || '') + '</p>'
          + (oc > 0 ? '<span class="inline-block text-[9px] font-mono bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 px-2 py-0.5 rounded-lg mt-1"><i class="fa-solid fa-sliders"></i> ' + oc + ' option' + (oc > 1 ? 's' : '') + '</span>' : '')
          + (m.newArrival ? '<span class="inline-block text-[9px] font-mono bg-amber-500/15 border border-amber-500/40 text-amber-300 px-2 py-0.5 rounded-lg mt-1 ml-1"><i class="fa-solid fa-star"></i> NEW ARRIVAL</span>' : '')
          + '</div>'
          + '<div class="flex items-center justify-between px-4 pb-4 pt-2 border-t border-slate-800 text-xs font-mono">'
          + '<button onclick="openEditCatalogModel(\'' + m.id + '\')" class="text-slate-400 hover:text-cyan-400 transition flex items-center gap-1"><i class="fa-solid fa-pen-to-square"></i> Edit</button>'
          + '<button onclick="deleteCatalogModel(\'' + m.id + '\')" class="text-slate-500 hover:text-rose-400 transition flex items-center gap-1"><i class="fa-solid fa-trash-can"></i> Remove</button>'
          + '</div></div>';
      }).join('');
    };

    window.toggleNewArrival = async function(id) {
      const m = catalogMap.get(id); if (!m) return;
      m.newArrival = !m.newArrival;
      renderOwnerCatalog(); renderShopGrid();
      await saveModelToDb(m);
      showToast(m.newArrival ? 'Marked as New Arrival: ' + m.title : 'Removed from New Arrivals: ' + m.title);
    };

    let currentModelImageData = '';
    let currentCrop = defaultCrop();
    let cropDragging = false, cropStartX = 0, cropStartY = 0, cropStartPosX = 50, cropStartPosY = 50;

    function applyCropToImage() {
      const img = document.getElementById('crop-image');
      const zoom = document.getElementById('crop-zoom');
      const zl = document.getElementById('crop-zoom-label');
      const aspectSel = document.getElementById('crop-aspect');
      const canvas = document.getElementById('crop-canvas');
      const pImg = document.getElementById('crop-preview-img');
      const pEmpty = document.getElementById('crop-preview-empty');
      const preview = document.getElementById('crop-preview');
      if (!img || img.style.display === 'none' || !currentModelImageData) return;
      const z = (currentCrop.zoom || 100) / 100;
      img.style.objectPosition = currentCrop.x + '% ' + currentCrop.y + '%';
      img.style.transform = 'scale(' + z + ')';
      img.style.transformOrigin = currentCrop.x + '% ' + currentCrop.y + '%';
      if (zoom) zoom.value = currentCrop.zoom || 100;
      if (zl) zl.innerText = (currentCrop.zoom || 100) + '%';
      if (aspectSel) aspectSel.value = currentCrop.aspect || '4/3';
      if (canvas) canvas.style.aspectRatio = currentCrop.aspect || '4/3';
      if (preview) preview.style.aspectRatio = currentCrop.aspect || '4/3';
      if (pImg && currentModelImageData) {
        pImg.src = currentModelImageData;
        pImg.style.display = 'block';
        pImg.style.objectPosition = currentCrop.x + '% ' + currentCrop.y + '%';
        pImg.style.transform = 'scale(' + z + ')';
        pImg.style.transformOrigin = currentCrop.x + '% ' + currentCrop.y + '%';
        if (pEmpty) pEmpty.style.display = 'none';
      }
    }

    window.handleModelImageUpload = function(event) {
      const file = event.target.files && event.target.files[0]; if (!file) return;
      if (file.size > 3 * 1024 * 1024) { showToast('Image too large. Use under 3MB.', 'error'); event.target.value = ''; return; }
      const r = new FileReader();
      r.onload = function(e) {
        currentModelImageData = e.target.result;
        document.getElementById('new-model-image-data').value = currentModelImageData;
        const img = document.getElementById('crop-image');
        img.src = currentModelImageData; img.style.display = 'block';
        document.getElementById('crop-empty').style.display = 'none';
        currentCrop = defaultCrop();
        applyCropToImage();
      };
      r.readAsDataURL(file);
    };
    window.clearModelImage = function() {
      currentModelImageData = ''; currentCrop = defaultCrop();
      document.getElementById('new-model-image-data').value = '';
      document.getElementById('new-model-image-file').value = '';
      const img = document.getElementById('crop-image'); img.src = ''; img.style.display = 'none';
      document.getElementById('crop-empty').style.display = 'flex';
      document.getElementById('crop-preview-img').style.display = 'none';
      document.getElementById('crop-preview-empty').style.display = 'flex';
    };
    window.resetCrop = function() { currentCrop = defaultCrop(); applyCropToImage(); };
    window.onCropZoom = function(v) { currentCrop.zoom = Number(v); applyCropToImage(); };
    window.onCropAspectChange = function(v) { currentCrop.aspect = v; applyCropToImage(); };

    (function setupCropDrag() {
      const canvas = document.getElementById('crop-canvas');
      if (!canvas) return;
      canvas.addEventListener('mousedown', startDrag);
      canvas.addEventListener('touchstart', startDrag, { passive: true });
      function startDrag(e) {
        if (!currentModelImageData) return;
        cropDragging = true; canvas.classList.add('dragging');
        const p = 'touches' in e ? e.touches[0] : e;
        cropStartX = p.clientX; cropStartY = p.clientY;
        cropStartPosX = currentCrop.x; cropStartPosY = currentCrop.y;
      }
      function onMove(e) {
        if (!cropDragging) return;
        const p = 'touches' in e ? e.touches[0] : e;
        const rect = canvas.getBoundingClientRect();
        const dx = (p.clientX - cropStartX) / rect.width * 100;
        const dy = (p.clientY - cropStartY) / rect.height * 100;
        currentCrop.x = Math.max(0, Math.min(100, cropStartPosX - dx));
        currentCrop.y = Math.max(0, Math.min(100, cropStartPosY - dy));
        applyCropToImage();
        if (e.cancelable) e.preventDefault();
      }
      function endDrag() { cropDragging = false; canvas.classList.remove('dragging'); }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('mouseup', endDrag);
      document.addEventListener('touchend', endDrag);
    })();

    let editingOptions = [];
    window.addOptionGroup = function() {
      editingOptions.push({ id: 'g' + Date.now() + Math.random().toString(36).substring(2, 5), name: '', choices: [{ value: '', label: '', priceDelta: 0 }] });
      renderOptionsBuilder();
    };
    window.removeOptionGroup = function(id) { editingOptions = editingOptions.filter(g => g.id !== id); renderOptionsBuilder(); };
    window.updateOptionGroupName = function(id, name) { const g = editingOptions.find(x => x.id === id); if (g) g.name = name; };
    window.addOptionChoice = function(id) { const g = editingOptions.find(x => x.id === id); if (!g) return; g.choices.push({ value: '', label: '', priceDelta: 0 }); renderOptionsBuilder(); };
    window.removeOptionChoice = function(id, i) { const g = editingOptions.find(x => x.id === id); if (!g) return; g.choices.splice(i, 1); if (g.choices.length === 0) g.choices.push({ value: '', label: '', priceDelta: 0 }); renderOptionsBuilder(); };
    window.updateOptionChoice = function(id, i, f, v) {
      const g = editingOptions.find(x => x.id === id); if (!g || !g.choices[i]) return;
      if (f === 'priceDelta') g.choices[i][f] = Number(v) || 0;
      else { g.choices[i][f] = v; if (f === 'label' && !g.choices[i].value) g.choices[i].value = v; }
    };
    function renderOptionsBuilder() {
      const c = document.getElementById('options-builder'); if (!c) return;
      if (editingOptions.length === 0) { c.innerHTML = '<p class="text-[10px] text-slate-500 font-mono text-center py-2 border border-dashed border-slate-800 rounded-xl">No options defined. Click "Add Group" to create one.</p>'; return; }
      c.innerHTML = editingOptions.map(g => '<div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-3 space-y-2">'
        + '<div class="flex items-center gap-2">'
        + '<input type="text" value="' + escapeAttr(g.name) + '" oninput="updateOptionGroupName(\'' + g.id + '\', this.value)" placeholder="Group name (e.g. Battery Holder)" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-cyan-500" />'
        + '<button type="button" onclick="removeOptionGroup(\'' + g.id + '\')" class="p-1.5 text-rose-400 hover:text-rose-300 transition"><i class="fa-solid fa-trash-can"></i></button>'
        + '</div><div class="space-y-1.5 pl-2">'
        + g.choices.map((ch, i) => '<div class="flex items-center gap-1.5">'
          + '<input type="text" value="' + escapeAttr(ch.label) + '" oninput="updateOptionChoice(\'' + g.id + '\', ' + i + ', \'label\', this.value)" placeholder="Choice (e.g. AAA)" class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-[11px] text-white focus:outline-none focus:border-cyan-500" />'
          + '<input type="number" value="' + (ch.priceDelta || 0) + '" oninput="updateOptionChoice(\'' + g.id + '\', ' + i + ', \'priceDelta\', this.value)" placeholder="+฿" class="w-16 bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-[11px] text-cyan-300 focus:outline-none focus:border-cyan-500" />'
          + '<button type="button" onclick="removeOptionChoice(\'' + g.id + '\', ' + i + ')" class="p-1 text-slate-500 hover:text-rose-400 transition"><i class="fa-solid fa-xmark text-xs"></i></button>'
          + '</div>').join('')
        + '<button type="button" onclick="addOptionChoice(\'' + g.id + '\')" class="text-[10px] font-mono text-cyan-400 hover:text-cyan-300 transition mt-1"><i class="fa-solid fa-plus"></i> Add choice</button>'
        + '</div></div>').join('');
    }

    window.openAddModelModal = function() {
      document.getElementById('edit-model-id').value = '';
      document.getElementById('model-modal-title').innerHTML = '<i class="fa-solid fa-plus text-cyan-400"></i> Add New 3D Print Model';
      document.getElementById('model-submit-btn').innerText = 'Add Model to Catalog';
      document.getElementById('new-model-title').value = '';
      document.getElementById('new-model-category').value = 'Articulated';
      document.getElementById('new-model-icon').value = 'fa-dragon';
      document.getElementById('new-model-price').value = '150';
      document.getElementById('new-model-desc').value = '';
      document.getElementById('new-model-new-arrival').checked = false;
      currentModelImageData = ''; currentCrop = defaultCrop();
      document.getElementById('new-model-image-data').value = '';
      document.getElementById('new-model-image-file').value = '';
      document.getElementById('crop-image').style.display = 'none';
      document.getElementById('crop-empty').style.display = 'flex';
      document.getElementById('crop-preview-img').style.display = 'none';
      document.getElementById('crop-preview-empty').style.display = 'flex';
      document.getElementById('crop-zoom').value = 100;
      document.getElementById('crop-zoom-label').innerText = '100%';
      document.getElementById('crop-aspect').value = '4/3';
      editingOptions = [];
      renderOptionsBuilder();
      document.getElementById('modal-add-model').classList.remove('hidden');
    };
    window.openEditCatalogModel = function(id) {
      const m = catalogMap.get(id); if (!m) return;
      document.getElementById('edit-model-id').value = m.id;
      document.getElementById('model-modal-title').innerHTML = '<i class="fa-solid fa-pen-to-square text-cyan-400"></i> Edit 3D Print Model';
      document.getElementById('model-submit-btn').innerText = 'Save Changes';
      document.getElementById('new-model-title').value = m.title;
      document.getElementById('new-model-category').value = m.category || 'Articulated';
      document.getElementById('new-model-icon').value = m.icon || 'fa-cube';
      document.getElementById('new-model-price').value = m.price;
      document.getElementById('new-model-desc').value = m.desc;
      document.getElementById('new-model-new-arrival').checked = !!m.newArrival;
      currentModelImageData = m.imageUrl || '';
      currentCrop = m.imageCrop ? JSON.parse(JSON.stringify(m.imageCrop)) : defaultCrop();
      document.getElementById('new-model-image-data').value = currentModelImageData;
      document.getElementById('new-model-image-file').value = '';
      const img = document.getElementById('crop-image');
      if (currentModelImageData) { img.src = currentModelImageData; img.style.display = 'block'; document.getElementById('crop-empty').style.display = 'none'; }
      else { img.src = ''; img.style.display = 'none'; document.getElementById('crop-empty').style.display = 'flex'; }
      applyCropToImage();
      editingOptions = JSON.parse(JSON.stringify(m.options || []));
      renderOptionsBuilder();
      document.getElementById('modal-add-model').classList.remove('hidden');
    };
    window.closeAddModelModal = function() {
      document.getElementById('modal-add-model').classList.add('hidden');
      currentModelImageData = ''; editingOptions = [];
    };
    window.submitNewCatalogModel = async function() {
      const id = document.getElementById('edit-model-id').value;
      const title = document.getElementById('new-model-title').value.trim();
      const category = document.getElementById('new-model-category').value;
      const icon = document.getElementById('new-model-icon').value;
      const price = parseInt(document.getElementById('new-model-price').value) || 150;
      const desc = document.getElementById('new-model-desc').value.trim() || 'Custom 3D printed model.';
      const newArrival = document.getElementById('new-model-new-arrival').checked;
      if (!title) { showToast('Enter a model title.', 'error'); return; }
      const cleanOpts = editingOptions.map(g => ({
        id: g.id, name: (g.name || '').trim(),
        choices: g.choices.map(c => ({ value: (c.value || c.label || '').trim(), label: (c.label || c.value || '').trim(), priceDelta: Number(c.priceDelta) || 0 })).filter(c => c.value !== '')
      })).filter(g => g.name !== '' && g.choices.length > 0);
      if (id) {
        const m = catalogMap.get(id);
        if (m) {
          m.title = title; m.category = category; m.icon = icon;
          m.price = price; m.desc = desc;
          m.imageUrl = currentModelImageData || '';
          m.imageCrop = currentModelImageData ? currentCrop : defaultCrop();
          m.options = cleanOpts;
          m.newArrival = newArrival;
          renderShopGrid(); renderOwnerCatalog();
          await saveModelToDb(m);
          showToast('Updated: ' + title);
        }
      } else {
        const nm = { id: 'mod-' + Date.now(), title, category, icon, price, desc, imageUrl: currentModelImageData || '', imageCrop: currentModelImageData ? currentCrop : defaultCrop(), options: cleanOpts, newArrival };
        catalogModels.unshift(nm); rebuildMaps(); renderShopGrid();
        if (activeView === 'owner') renderOwnerCatalog();
        await saveModelToDb(nm);
        showToast('Added: ' + title);
      }
      closeAddModelModal();
    };
    window.deleteCatalogModel = async function(id) {
      catalogModels = catalogModels.filter(m => m.id !== id);
      rebuildMaps(); renderShopGrid();
      if (activeView === 'owner') renderOwnerCatalog();
      await removeModelFromDb(id);
      showToast('Model removed.');
    };

    window.debounceRenderOwnerPortalOrders = function() {
      if (ownerSearchDebounceTimer) clearTimeout(ownerSearchDebounceTimer);
      ownerSearchDebounceTimer = setTimeout(() => renderOwnerPortalOrders(), 150);
    };
    window.renderOwnerPortalOrders = function() {
      const tb = document.getElementById('owner-orders-table-body'); if (!tb) return;
      const s = (document.getElementById('owner-search-input') || {}).value || '';
      const search = s.toLowerCase();
      const f = orders.filter(o => o.trackingCode.toLowerCase().includes(search) || (o.customerName || '').toLowerCase().includes(search) || (o.modelTitle || '').toLowerCase().includes(search));
      if (f.length === 0) { tb.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-slate-500">No customer orders found.</td></tr>'; return; }
      const sn = ['Received', 'Printing', 'Packaged', 'Ready for Pickup'];
      tb.innerHTML = f.map(o => {
        const st = Math.max(0, Math.min(3, o.stage));
        const items = o.items || [];
        let itemsHtml = '';
        if (items.length > 0) {
          itemsHtml = '<table class="order-items-table">'
            + '<thead><tr><th>Item</th><th>Filament</th><th>Scale</th><th>Options</th><th class="text-right">Price</th></tr></thead>'
            + '<tbody>'
            + items.map(it => {
                const optStr = (it.options && Object.keys(it.options).length > 0)
                  ? Object.keys(it.options).map(k => escapeHtml(k) + '=' + escapeHtml(it.options[k])).join(', ')
                  : '—';
                return '<tr>'
                  + '<td class="text-white font-bold"><i class="fa-solid ' + (it.icon || 'fa-cube') + ' text-cyan-400 mr-1"></i> ' + escapeHtml(it.title) + '</td>'
                  + '<td><span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full" style="background:' + (it.filamentColor || '#64748b') + '"></span> ' + escapeHtml(it.filamentName || '') + '</span></td>'
                  + '<td class="text-cyan-300">' + (it.scale || 100) + '%</td>'
                  + '<td class="text-slate-400">' + optStr + '</td>'
                  + '<td class="text-right text-emerald-400">฿' + (it.unitPrice || 0) + '</td>'
                  + '</tr>';
              }).join('')
            + '</tbody></table>';
        } else {
          const so = o.selectedOptions || {};
          const optHtml = Object.keys(so).length > 0
            ? Object.keys(so).map(k => '<span class="inline-block bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-[10px] px-2 py-0.5 rounded-md mr-1 mb-1">' + escapeHtml(k) + ': <strong class="text-white">' + escapeHtml(so[k]) + '</strong></span>').join('')
            : '<span class="text-slate-600 italic">None</span>';
          itemsHtml = '<div class="text-[10px] text-slate-500 mb-1">' + escapeHtml(o.specs) + '</div>' + optHtml;
        }
        const total = items.reduce((s, it) => s + (it.unitPrice || 0), 0);
        const totalHtml = items.length > 0 ? '<div class="text-[10px] text-emerald-400 font-bold mt-1">Total: ฿' + total + ' · ' + items.length + ' piece' + (items.length > 1 ? 's' : '') + '</div>' : '';
        const optionsHtml = sn.map((name, i) =>
          '<option value="' + i + '"' + (i === st ? ' selected' : '') + '>' + (i + 1) + '. ' + name + '</option>'
        ).join('');
        return '<tr class="hover:bg-slate-900/60 transition">'
          + '<td class="p-3 font-bold text-cyan-400 align-top">' + o.trackingCode + '</td>'
          + '<td class="p-3 align-top"><span class="text-white block font-bold">' + escapeHtml(o.customerName) + '</span></td>'
          + '<td class="p-3 text-slate-200">' + itemsHtml + totalHtml + '</td>'
          + '<td class="p-3 align-top"><select class="stage-select s' + st + '" onchange="changeOrderStage(\'' + o.trackingCode + '\', this.value)">' + optionsHtml + '</select></td>'
          + '<td class="p-3 text-right align-top">'
          + '<button onclick="deleteOrder(\'' + o.trackingCode + '\')" class="p-1.5 text-slate-500 hover:text-rose-400 transition" title="Delete order"><i class="fa-solid fa-trash-can"></i></button>'
          + '</td></tr>';
      }).join('');
    };
    window.changeOrderStage = async function(code, newStage) {
      const o = orderMap.get(code); if (!o) return;
      const st = Math.max(0, Math.min(3, Number(newStage)));
      if (st === o.stage) return;
      const sn = ['Received', 'Printing in Progress', 'Inspected & Packaged', 'Ready for Pickup'];
      o.stage = st;
      o.logs.push('▶ Status changed by Owner to: ' + sn[st]);
      renderOwnerPortalOrders(); renderOwnerPortal();
      await saveOrderToDb(o);
      showToast('Order ' + code + ' → ' + sn[st]);
    };
    window.deleteOrder = async function(code) {
      orders = orders.filter(o => o.trackingCode !== code);
      rebuildMaps();
      if (activeView === 'owner') renderOwnerPortal();
      await removeOrderFromDb(code);
      showToast('Order ' + code + ' deleted.');
    };

    // ============================================================
    // BOOT
    // ============================================================
    window.addEventListener('load', function() {
      loadCart();
      updateCartBadge();
      // If firebase already loaded before this ran, start boot
      if (window.__fb && window.__fb.ready) {
        fbReady = true;
        firebase = window.__fb;
        initBackend();
      }
    });
  </script>
