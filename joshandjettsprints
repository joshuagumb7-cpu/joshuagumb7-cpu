    window.renderOwnerFilaments = function() {
      const c = document.getElementById('owner-filaments-container'); if (!c) return;
      if (filaments.length === 0) { c.innerHTML = '<p class="col-span-full text-xs font-mono text-slate-500">No filaments.</p>'; return; }
      c.innerHTML = filaments.map((f, i) => {
