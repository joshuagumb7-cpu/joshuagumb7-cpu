    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // Expose to global so the main script can use them
    window.__fb = {
      db,
      collection, doc, getDocs, getDoc, setDoc, deleteDoc, writeBatch, onSnapshot,
      ready: true
    };
    window.dispatchEvent(new Event('firebase-ready'));
  </script>

  <style>
    body { font-family: 'Inter', sans-serif; background: radial-gradient(circle at 50% 0%, #0f172a 0%, #020617 100%); min-height: 100vh; }
    .glass-panel { background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.08); }
    .glass-card { background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.05); transition: all .25s cubic-bezier(.4,0,.2,1); }
    .glass-card:hover { border-color: rgba(34,211,238,.3); transform: translateY(-2px); box-shadow: 0 12px 30px -10px rgba(6,182,212,.15); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #0891b2; }
    input[type=range] { accent-color: #06b6d4; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .input-error { border-color: #f43f5e !important; box-shadow: 0 0 0 3px rgba(244,63,94,.15); }
    .field-error-msg { color: #fda4af; font-size: 10px; font-family: 'Fira Code', monospace; margin-top: 4px; display: flex; align-items: center; gap: 4px; }

    .option-chip { cursor: pointer; user-select: none; }
    .option-chip.selected { border-color: #06b6d4 !important; background: rgba(8,145,178,.25) !important; color: #fff !important; }

    .product-img-wrap { position: relative; width: 100%; aspect-ratio: 4/3; overflow: hidden; background: #0f172a; border-radius: 1rem 1rem 0 0; cursor: pointer; }
    .product-img-wrap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; will-change: transform, object-position; }
    .product-img-wrap:hover img { filter: brightness(1.1); }
    .product-img-wrap .zoom-hint { position: absolute; inset: 0; background: rgba(0,0,0,0); display: flex; align-items: center; justify-content: center; opacity: 0; transition: all .2s; }
    .product-img-wrap:hover .zoom-hint { background: rgba(0,0,0,0.35); opacity: 1; }
    .img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(6,182,212,.08), rgba(16,185,129,.08)); }

    #crop-canvas { position: relative; width: 100%; aspect-ratio: 4/3; overflow: hidden; background: #020617; border-radius: 1rem; cursor: grab; }
    #crop-canvas.dragging { cursor: grabbing; }
    #crop-canvas img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; user-select: none; pointer-events: none; }
    #crop-grid { position: absolute; inset: 0; pointer-events: none; opacity: .25; background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 33.33% 33.33%; }
    #crop-border { position: absolute; inset: 8px; border: 2px solid rgba(34,211,238,.7); border-radius: .75rem; pointer-events: none; }

    .sync-pill { display: inline-flex; align-items: center; gap: .4rem; font-size: 10px; font-family: 'Fira Code', monospace; padding: .25rem .55rem; border-radius: .6rem; border: 1px solid rgba(255,255,255,.08); background: rgba(15,23,42,.7); }
    .sync-pill.ok { border-color: rgba(16,185,129,.4); color: #6ee7b7; }
    .sync-pill.busy { border-color: rgba(34,211,238,.4); color: #67e8f9; }
    .sync-pill.err { border-color: rgba(244,63,94,.4); color: #fda4af; }
    .sync-pill.failed { border-color: rgba(244,63,94,.6); color: #fda4af; background: rgba(76,5,25,.5); }
    .sync-dot { width: 6px; height: 6px; border-radius: 9999px; background: currentColor; }
    .sync-pill.busy .sync-dot { animation: pulse 1s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:.3} 50%{opacity:1} }

    #sync-banner {
      position: fixed; top: 0; left: 0; right: 0; z-index: 70;
      transform: translateY(-110%); transition: transform .3s cubic-bezier(.4,0,.2,1), opacity .3s ease;
      opacity: 0; pointer-events: none;
    }
    #sync-banner.active { transform: translateY(0); opacity: 1; pointer-events: auto; }
    #sync-banner .bar-fill { height: 3px; background: linear-gradient(90deg, #22d3ee, #10b981); transition: width .3s ease; }
    #sync-banner.failed .bar-fill { background: linear-gradient(90deg, #f43f5e, #f97316); }
    #sync-banner.failed #sync-banner-icon { color: #fda4af !important; }
    #sync-banner.failed #sync-banner-sub { color: #fda4af; }
    #sync-banner.success .bar-fill { background: linear-gradient(90deg, #10b981, #22d3ee); }

    .count-badge {
      display: inline-flex; align-items: center; gap: .35rem;
      font-family: 'Fira Code', monospace; font-size: 10px;
      padding: .2rem .5rem; border-radius: .5rem;
      border: 1px solid rgba(255,255,255,.08);
      background: rgba(2,6,23,.6);
      transition: all .2s ease;
      white-space: nowrap;
    }
    .count-badge.done { border-color: rgba(16,185,129,.5); color: #6ee7b7; }
    .count-badge.pending { color: #94a3b8; }
    .count-badge.partial { border-color: rgba(34,211,238,.5); color: #67e8f9; }
    .count-badge.failed { border-color: rgba(244,63,94,.6); color: #fda4af; background: rgba(76,5,25,.5); }

    .blink { animation: blink 1s ease-in-out infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }

    .full-menu-shell { width: 100vw; height: 100vh; max-width: none; max-height: none; border-radius: 0; }
    @media (min-width: 768px) {
      .full-menu-shell { width: 95vw; height: 95vh; border-radius: 1.5rem; }
    }

    .filament-card { display: flex; flex-direction: column; gap: .75rem; min-height: 100px; }
    .filament-card .filament-name { word-break: break-word; overflow-wrap: anywhere; line-height: 1.25; flex: 1; min-width: 0; }
    .filament-actions { display: flex; flex-wrap: wrap; gap: 2px; align-items: center; flex-shrink: 0; }
    .filament-actions button { flex-shrink: 0; }

    .pickup-message {
      font-size: clamp(1.75rem, 5vw, 3.5rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.05;
      background: linear-gradient(90deg, #22d3ee 0%, #10b981 50%, #06b6d4 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
      padding: .5rem 0;
      animation: pickupGlow 3s ease-in-out infinite;
    }
    @keyframes pickupGlow {
      0%,100% { filter: drop-shadow(0 0 8px rgba(34,211,238,.35)); }
      50% { filter: drop-shadow(0 0 20px rgba(16,185,129,.55)); }
    }
    .pickup-card {
      background: linear-gradient(135deg, rgba(6,182,212,.10), rgba(16,185,129,.10));
      border: 1px solid rgba(34,211,238,.35);
      border-radius: 1.5rem;
      padding: 1.25rem 1rem;
    }

    .stage-select {
      background: rgba(2,6,23,.7);
      border: 1px solid rgba(255,255,255,.10);
      border-radius: .5rem;
      padding: .3rem .5rem;
      font-family: 'Fira Code', monospace;
      font-size: 10px;
      color: #e2e8f0;
      cursor: pointer;
      outline: none;
      transition: border-color .2s;
    }
    .stage-select:focus { border-color: #06b6d4; }
    .stage-select.s0 { border-color: rgba(148,163,184,.4); }
    .stage-select.s1 { border-color: rgba(245,158,11,.5); color: #fcd34d; }
    .stage-select.s2 { border-color: rgba(168,85,247,.5); color: #d8b4fe; }
    .stage-select.s3 { border-color: rgba(16,185,129,.5); color: #6ee7b7; }

    .cart-btn { position: relative; }
    .cart-badge {
      position: absolute; top: -6px; right: -6px;
      min-width: 18px; height: 18px;
      border-radius: 9999px;
      background: linear-gradient(135deg, #06b6d4, #10b981);
      color: #020617;
      font-weight: 900;
      font-size: 10px;
      display: flex; align-items: center; justify-content: center;
      padding: 0 4px;
      box-shadow: 0 4px 10px rgba(6,182,212,.4);
      font-family: 'Fira Code', monospace;
    }
    .cart-badge.empty { display: none; }

    .new-badge {
      position: absolute; top: 12px; right: 12px;
      background: linear-gradient(135deg, #22d3ee, #10b981);
      color: #020617;
      font-size: 9px; font-weight: 900;
      padding: 4px 8px;
      border-radius: .5rem;
      font-family: 'Fira Code', monospace;
      z-index: 10;
      letter-spacing: .05em;
      box-shadow: 0 0 16px rgba(34,211,238,.55);
      animation: newBadgePulse 2s ease-in-out infinite;
    }
    @keyframes newBadgePulse {
      0%,100% { box-shadow: 0 0 16px rgba(34,211,238,.55); }
      50% { box-shadow: 0 0 26px rgba(16,185,129,.75); }
    }

    .cart-item {
      display: flex; align-items: center; gap: 12px;
      padding: 12px;
      background: rgba(15,23,42,.6);
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 1rem;
      transition: border-color .2s;
    }
    .cart-item:hover { border-color: rgba(34,211,238,.3); }
    .cart-thumb {
      width: 56px; height: 56px;
      border-radius: .75rem;
      background: #020617;
      overflow: hidden;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(255,255,255,.06);
    }
    .cart-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .qty-btn {
      width: 22px; height: 22px;
      border-radius: .4rem;
      background: rgba(15,23,42,.8);
      border: 1px solid rgba(255,255,255,.1);
      color: #cbd5e1;
      font-size: 11px; font-weight: 900;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: all .15s;
      font-family: 'Fira Code', monospace;
    }
    .qty-btn:hover { background: rgba(6,182,212,.2); border-color: rgba(6,182,212,.4); color: #fff; }

    .cart-table { width: 100%; font-family: 'Fira Code', monospace; font-size: 11px; }
    .cart-table th { text-align: left; padding: 8px; color: #64748b; text-transform: uppercase; font-size: 9px; letter-spacing: .05em; border-bottom: 1px solid rgba(255,255,255,.08); }
    .cart-table td { padding: 8px; border-bottom: 1px solid rgba(255,255,255,.04); }

    #lightbox { position: fixed; inset: 0; z-index: 90; background: rgba(2,6,23,.95); backdrop-filter: blur(12px); display: none; align-items: center; justify-content: center; padding: 20px; cursor: zoom-out; }
    #lightbox.active { display: flex; }
    #lightbox img { max-width: 95vw; max-height: 90vh; object-fit: contain; border-radius: 1rem; box-shadow: 0 0 60px rgba(6,182,212,.3); }
    #lightbox .close-hint { position: absolute; top: 20px; right: 20px; color: #cbd5e1; font-size: 12px; font-family: 'Fira Code', monospace; display: flex; align-items: center; gap: 8px; }
    #lightbox .close-hint button { background: rgba(15,23,42,.9); border: 1px solid rgba(255,255,255,.1); padding: 8px 14px; border-radius: .75rem; color: #fff; cursor: pointer; }
    #lightbox .close-hint button:hover { background: rgba(6,182,212,.2); border-color: rgba(6,182,212,.4); }

    .buy-hero-img { width: 100%; height: 100%; object-fit: contain; background: #020617; }
    .buy-hero-wrap { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #020617; overflow: hidden; }

    .order-items-table { width: 100%; font-family: 'Fira Code', monospace; font-size: 10px; margin-top: 6px; border-collapse: collapse; }
    .order-items-table th { text-align: left; padding: 4px 6px; color: #64748b; font-size: 9px; border-bottom: 1px solid rgba(255,255,255,.06); }
    .order-items-table td { padding: 4px 6px; border-bottom: 1px solid rgba(255,255,255,.03); }

    .kings-pill {
      display: inline-flex; align-items: center; gap: .4rem;
      font-size: 10px; font-family: 'Fira Code', monospace;
      padding: .3rem .7rem; border-radius: 9999px;
      background: linear-gradient(135deg, rgba(34,211,238,.15), rgba(16,185,129,.15));
      border: 1px solid rgba(34,211,238,.4);
      color: #67e8f9;
      font-weight: 700;
      letter-spacing: .03em;
      box-shadow: 0 0 20px rgba(34,211,238,.15);
    }
    .kings-pill i { color: #fcd34d; }
  </style>
</head>
<body class="flex flex-col min-h-screen text-slate-100 antialiased selection:bg-cyan-500 selection:text-slate-950">

  <!-- SYNC BANNER -->
  <div id="sync-banner">
    <div class="glass-panel border-b border-slate-800 shadow-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="flex items-center gap-3 flex-shrink-0">
            <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
              <i id="sync-banner-icon" class="fa-solid fa-arrows-rotate fa-spin"></i>
            </div>
            <div>
              <p id="sync-banner-title" class="text-xs font-black font-mono uppercase tracking-wider text-white">Syncing Data</p>
              <p id="sync-banner-sub" class="text-[10px] font-mono text-cyan-300">Syncing with the server...</p>
            </div>
          </div>

          <div class="flex-1 min-w-0">
            <div id="sync-counts" class="flex flex-wrap items-center gap-2">
              <span class="count-badge pending" data-badge="models"><span data-arrow="models">↓</span> <i class="fa-solid fa-cube"></i> <span data-count="models">0/0</span> models</span>
              <span class="count-badge pending" data-badge="filaments"><span data-arrow="filaments">↓</span> <i class="fa-solid fa-palette"></i> <span data-count="filaments">0/0</span> filaments</span>
              <span class="count-badge pending" data-badge="orders"><span data-arrow="orders">↑</span> <i class="fa-solid fa-list-check"></i> <span data-count="orders">0/0</span> orders</span>
            </div>
            <div class="mt-2 w-full h-1.5 bg-slate-900 rounded-full overflow-hidden border border-slate-800">
              <div id="sync-bar-fill" class="bar-fill" style="width:0%"></div>
            </div>
          </div>

          <div class="flex-shrink-0 flex items-center gap-3">
            <span id="sync-warning" class="text-sm font-black font-mono text-rose-400 blink">PLEASE DO NOT CLOSE THIS PAGE</span>
            <span id="sync-percent" class="text-xs font-mono text-slate-400">0%</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX -->
  <div id="lightbox" onclick="closeLightbox()">
    <div class="close-hint">
      <span>Click anywhere or press ESC to close</span>
      <button onclick="event.stopPropagation(); closeLightbox();"><i class="fa-solid fa-xmark"></i> Close</button>
    </div>
    <img id="lightbox-img" src="" alt="" onclick="event.stopPropagation();" />
  </div>

  <!-- INITIAL BOOT LOADING -->
  <div id="global-loading-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950/95 backdrop-blur-xl transition-opacity duration-300 hidden">
    <div class="relative w-24 h-24 mb-6">
      <div id="loading-spinner-ring" class="absolute inset-0 rounded-3xl border-4 border-cyan-500/20 animate-pulse"></div>
      <div id="loading-spinner-spin" class="absolute inset-0 rounded-3xl border-4 border-cyan-400 border-t-transparent animate-spin"></div>
      <div class="absolute inset-0 flex items-center justify-center text-cyan-400 text-2xl font-black">
        <i id="loading-icon" class="fa-solid fa-cube animate-bounce"></i>
      </div>
    </div>
    <div class="space-y-2 text-center max-w-md px-4">
      <h2 id="loading-title" class="text-base font-black tracking-tight text-white font-mono uppercase">Loading Shop</h2>
      <p id="loading-subtitle" class="text-xs text-slate-400 font-mono">Downloading latest from server...</p>
      <div id="loading-bar-container" class="w-48 h-1.5 bg-slate-900 rounded-full mx-auto overflow-hidden border border-slate-800 mt-3">
        <div id="loading-bar-fill" class="h-full bg-gradient-to-r from-cyan-500 to-emerald-500 transition-all duration-300 w-1/3"></div>
      </div>
      <div id="loading-error-box" class="hidden mt-4 p-4 rounded-2xl bg-rose-950/60 border border-rose-500/40 text-left font-mono text-xs space-y-2.5 shadow-2xl">
        <div class="flex items-center justify-between border-b border-rose-500/30 pb-2">
          <span class="text-rose-400 font-bold uppercase flex items-center gap-1.5"><i class="fa-solid fa-circle-xmark"></i> Connection Problem</span>
          <span id="loading-error-code" class="text-[10px] bg-rose-900/80 text-rose-200 px-2 py-0.5 rounded border border-rose-500/30">CODE: ERR</span>
        </div>
        <div><span class="text-slate-400 text-[10px] block uppercase">Request:</span><span id="loading-error-request" class="text-cyan-300 text-xs font-bold break-all">—</span></div>
        <div><span class="text-slate-400 text-[10px] block uppercase">Details:</span><p id="loading-error-desc" class="text-rose-300 text-[11px] leading-relaxed break-words">Unable to reach the shop server.</p></div>
      </div>
      <div id="loading-error-actions" class="hidden flex flex-wrap items-center justify-center gap-2 pt-3">
        <button onclick="dismissLoadingErrorAndUseOffline()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-mono font-semibold transition flex items-center gap-1.5 shadow-md"><i class="fa-solid fa-wifi text-amber-400"></i> Continue Offline</button>
        <button onclick="retryBackendConnection()" class="px-3.5 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition flex items-center gap-1.5 shadow-md"><i class="fa-solid fa-rotate-right"></i> Retry Connection</button>
      </div>
    </div>
  </div>

  <header class="sticky top-0 z-40 border-b border-slate-800/80 glass-panel">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="navigateTo('shop')">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 via-teal-500 to-emerald-500 p-0.5 shadow-lg shadow-cyan-500/20 flex items-center justify-center">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center"><i class="fa-solid fa-cube text-cyan-400 text-lg sm:text-xl"></i></div>
          </div>
          <div>
            <h1 class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-2">
              Josh and Jett's <span class="text-emerald-400 font-extrabold text-xs uppercase tracking-widest px-2 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-500/30">3D Prints</span>
            </h1>
            <p class="text-[11px] text-cyan-300/80 hidden sm:block font-mono font-bold">Exclusive to King's Bangkok Students &amp; Teachers</p>
          </div>
        </div>

        <div class="flex items-center space-x-1.5 sm:space-x-3">
          <div id="sync-pill" class="sync-pill ok hidden sm:inline-flex" title="Sync status">
            <span class="sync-dot"></span><span id="sync-pill-text">Synced</span>
          </div>
          <button onclick="customerSync()" id="sync-btn" class="px-2.5 py-2 rounded-xl text-xs font-semibold text-cyan-300 hover:text-cyan-200 hover:bg-cyan-950/40 border border-cyan-500/30 transition flex items-center gap-1.5" title="Sync my order & tracking">
