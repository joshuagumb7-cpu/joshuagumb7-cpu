  </div>

  <script>
    // ============================================================
    // GLOBAL STATE
    // ============================================================
    let catalogModels = [];
    let filaments = [];
    let orders = [];
    let cart = [];
    let catalogMap = new Map(), filamentMap = new Map(), orderMap = new Map();

    let searchDebounceTimer = null, ownerSearchDebounceTimer = null;
    let currentCategory = 'All';
    let activeView = 'shop';
    let activeTrackingCode = null;
    let currentConfiguredModel = null;
    let selectedFilamentId = null;
    let selectedOptions = {};

    let fbReady = false;
    let firebase = null;

    let syncState = {
      active: false,
      counts: {
        models:    { done: 0, total: 0, failed: 0, dir: 'pull' },
        filaments: { done: 0, total: 0, failed: 0, dir: 'pull' },
        orders:    { done: 0, total: 0, failed: 0, dir: 'push' }
      }
    };

    // Listen for the firebase-ready event from the module script
    window.addEventListener('firebase-ready', function() {
      fbReady = true;
      firebase = window.__fb;
      // Kick off the boot sequence
      initBackend();
    });

    // Fallback: if the module loads before this listener attaches, poll for it
    (function pollForFirebase() {
      if (window.__fb && window.__fb.ready && !fbReady) {
        fbReady = true;
        firebase = window.__fb;
        initBackend();
        return;
      }
      if (!fbReady) setTimeout(pollForFirebase, 50);
    })();

    // ============================================================
    // FIREBASE HELPERS
    // ============================================================
    const COL_MODELS = 'catalog_models';
    const COL_FILAMENTS = 'filaments';
    const COL_ORDERS = 'orders';

    // Read all docs from a collection (fast — single round trip)
    async function readCollection(name) {
      const snap = await firebase.getDocs(firebase.collection(firebase.db, name));
      const out = [];
      snap.forEach(d => out.push(d.data()));
      return out;
    }

    // Write a single doc
    async function writeDoc(colName, id, payload) {
      await firebase.setDoc(firebase.doc(firebase.db, colName, String(id)), payload);
    }

    // Delete a single doc
    async function deleteDocById(colName, id) {
      await firebase.deleteDoc(firebase.doc(firebase.db, colName, String(id)));
    }

    // Bulk write via writeBatch (up to 500 ops per batch — splits automatically)
    async function bulkWrite(colName, items, getIdFn) {
      const chunks = [];
      for (let i = 0; i < items.length; i += 400) chunks.push(items.slice(i, i + 400));
      for (const chunk of chunks) {
        const batch = firebase.writeBatch(firebase.db);
        for (const item of chunk) {
          const id = String(getIdFn(item));
          batch.set(firebase.doc(firebase.db, colName, id), item);
        }
        await batch.commit();
      }
    }

    // Bulk delete
    async function bulkDelete(colName, ids) {
      const chunks = [];
      for (let i = 0; i < ids.length; i += 400) chunks.push(ids.slice(i, i + 400));
      for (const chunk of chunks) {
        const batch = firebase.writeBatch(firebase.db);
        for (const id of chunk) {
          batch.delete(firebase.doc(firebase.db, colName, String(id)));
        }
        await batch.commit();
      }
    }

    // ============================================================
    // SYNC BANNER
    // ============================================================
    window.flashBanner = function() {};

    function showSyncBanner(title, subtitle) {
      const b = document.getElementById('sync-banner');
      b.classList.remove('failed', 'success', 'flash');
      b.classList.add('active');
      document.getElementById('sync-banner-title').innerText = title || 'Syncing Data';
      document.getElementById('sync-banner-sub').innerText = subtitle || 'Syncing with the server...';
      document.getElementById('sync-banner-icon').className = 'fa-solid fa-arrows-rotate fa-spin';
      document.getElementById('sync-warning').style.display = '';
      syncState.active = true;
    }
    function hideSyncBanner() {
      const b = document.getElementById('sync-banner');
      b.classList.remove('active');
      syncState.active = false;
    }
    function setSyncCounts(category, done, total, failed, dir) {
      if (syncState.counts[category]) {
        syncState.counts[category].done = done;
        syncState.counts[category].total = total;
        syncState.counts[category].failed = failed || 0;
        if (dir) syncState.counts[category].dir = dir;
      }
      renderSyncCounts();
    }
    function renderSyncCounts() {
      let totalDone = 0, totalAll = 0, totalFailed = 0;
      ['models', 'filaments', 'orders'].forEach(c => {
        const st = syncState.counts[c];
        totalDone += st.done;
        totalAll += st.total;
        totalFailed += st.failed;
        const badge = document.querySelector('[data-badge="' + c + '"]');
        const span = document.querySelector('[data-count="' + c + '"]');
        const arrow = document.querySelector('[data-arrow="' + c + '"]');
        if (badge && span) {
          span.innerText = st.done + '/' + st.total + (st.failed > 0 ? ' (' + st.failed + ' failed)' : '');
          badge.classList.remove('done', 'pending', 'partial', 'failed');
          if (st.failed > 0) badge.classList.add('failed');
          else if (st.total > 0 && st.done === st.total) badge.classList.add('done');
          else if (st.done > 0) badge.classList.add('partial');
          else badge.classList.add('pending');
        }
        if (arrow) {
          arrow.innerText = st.dir === 'pull' ? '↓' : '↑';
          arrow.title = st.dir === 'pull' ? 'Downloading' : 'Uploading';
        }
      });
      const pct = totalAll === 0 ? 0 : Math.round((totalDone / totalAll) * 100);
      document.getElementById('sync-bar-fill').style.width = pct + '%';
      document.getElementById('sync-percent').innerText = pct + '%';
      return { totalDone, totalAll, totalFailed };
    }
    function finalizeSyncBanner(success, failedCount, customTitle) {
      const b = document.getElementById('sync-banner');
      const sub = document.getElementById('sync-banner-sub');
      const title = document.getElementById('sync-banner-title');
      const icon = document.getElementById('sync-banner-icon');
      const warn = document.getElementById('sync-warning');
      if (success) {
        b.classList.add('success');
        icon.className = 'fa-solid fa-circle-check';
        title.innerText = customTitle || 'Sync Complete';
        sub.innerText = 'All data saved and verified on the server.';
        warn.style.display = 'none';
      } else {
        b.classList.add('failed');
        icon.className = 'fa-solid fa-triangle-exclamation';
        title.innerText = 'Sync Failed';
        sub.innerText = failedCount + ' item(s) could not be verified after 3 retries.';
        warn.style.display = 'none';
      }
      setTimeout(() => { hideSyncBanner(); }, success ? 2500 : 6000);
    }

    // ============================================================
    // DATA MAPPING (Firebase stores as-is; we just normalize on read)
    // ============================================================
    function safeParse(s, fb) { try { return JSON.parse(s); } catch(e) { return fb; } }
    function defaultCrop() { return { x: 50, y: 50, zoom: 100, aspect: '4/3' }; }

    function normalizeModel(row) {
      return {
        id: row.id, title: row.title || '', category: row.category || 'Articulated',
        icon: row.icon || 'fa-cube',
        price: Number(row.price || 0),
        desc: row.desc || '',
        imageUrl: row.imageUrl || '',
        imageCrop: (row.imageCrop && typeof row.imageCrop === 'object') ? row.imageCrop : defaultCrop(),
        options: Array.isArray(row.options) ? row.options : [],
        newArrival: row.newArrival === true
      };
    }
    function normalizeFilament(row) {
      return {
        id: row.id, name: row.name || '', color: row.color || '#06b6d4',
        surcharge: Number(row.surcharge || 0),
        description: row.description || '',
        inStock: row.inStock !== false,
        sortOrder: Number(row.sortOrder || 0)
      };
    }
    function normalizeOrder(row) {
      return {
        trackingCode: row.trackingCode, customerName: row.customerName || '',
        modelTitle: row.modelTitle || '', modelIcon: row.modelIcon || 'fa-cube',
        specs: row.specs || '', printerName: row.printerName || '',
        stage: Number(row.stage || 0),
        logs: Array.isArray(row.logs) ? row.logs : [],
        selectedOptions: row.selectedOptions || {},
        items: Array.isArray(row.items) ? row.items : [],
        createdAt: row.createdAt || ''
      };
    }

    function rebuildMaps() {
      catalogMap.clear(); catalogModels.forEach(m => catalogMap.set(m.id, m));
      filamentMap.clear(); filaments.forEach(f => filamentMap.set(f.id, f));
      orderMap.clear(); orders.forEach(o => orderMap.set(o.trackingCode, o));
    }

    // ============================================================
    // DEFAULT DATA
    // ============================================================
    function getDefaultModels() {
      return [
        { id: 'mod-1', title: 'Articulated Crystal Dragon', category: 'Articulated', icon: 'fa-dragon', price: 250, desc: 'Fully flexible print-in-place crystal dragon with beautiful segmented joints.', imageUrl: '', imageCrop: defaultCrop(), options: [], newArrival: true },
        { id: 'mod-2', title: 'Modular Gear Fidget Spinner', category: 'Fidget', icon: 'fa-gear', price: 120, desc: 'Satisfying mechanical interlocking print with smooth counter-rotational gears.', imageUrl: '', imageCrop: defaultCrop(), options: [], newArrival: false },
        { id: 'mod-3', title: 'Self-Watering Planter Pot', category: 'Desk Decor', icon: 'fa-cube', price: 180, desc: 'Two-piece planter with internal reservoir wick system for low maintenance desk plants.', imageUrl: '', imageCrop: defaultCrop(), options: [], newArrival: false },
        { id: 'mod-4', title: 'Mechanical Screw Organizer', category: 'Tools', icon: 'fa-box', price: 210, desc: 'Precision threaded cylindrical storage box for hardware fasteners and tiny items.', imageUrl: '', imageCrop: defaultCrop(), options: [], newArrival: true }
      ];
    }
    function getDefaultFilaments() {
      return [
        { id: 'neon-cyan', name: 'Silk Neon Cyan PLA', color: '#06b6d4', surcharge: 0, description: 'Shiny silk finish with a bright neon cyan color.', inStock: true, sortOrder: 0 },
        { id: 'emerald-green', name: 'Emerald Green PLA', color: '#10b981', surcharge: 10, description: 'Rich emerald green with a matte finish.', inStock: true, sortOrder: 1 },
        { id: 'galaxy-black', name: 'Galaxy Glitter Black', color: '#334155', surcharge: 15, description: 'Deep black with sparkly glitter flecks.', inStock: true, sortOrder: 2 },
        { id: 'sunset-orange', name: 'Sunset Matte Orange', color: '#f97316', surcharge: 5, description: 'Warm sunset orange with a soft matte surface.', inStock: true, sortOrder: 3 }
      ];
    }
    function getDefaultOrders() {
      return [{
        trackingCode: '8A7F9X2B', customerName: 'Josh Maker',
        modelTitle: 'Articulated Crystal Dragon', modelIcon: 'fa-dragon',
        specs: 'Silk Neon Cyan PLA | 100% Scale (฿250)', printerName: 'Bambu Lab A2L',
        stage: 1, logs: ['▶ Order created.', '▶ Material loaded: Silk Neon Cyan PLA.', '▶ First layer calibration complete.'],
        selectedOptions: {}, items: [], createdAt: new Date().toISOString().replace('T', ' ').substring(0, 16)
      }];
    }

    function loadDefaultInMemoryData() {
      catalogModels = getDefaultModels();
      filaments = getDefaultFilaments();
      orders = getDefaultOrders();
      selectedFilamentId = filaments[0] ? filaments[0].id : null;
      rebuildMaps();
    }

    // ============================================================
    // BACKEND BOOT
    // ============================================================
    async function initBackend() {
      showLoading('Loading Shop', 'Connecting to Firebase...');
      setSyncPill('busy', 'Connecting');

      try {
        if (!firebase || !firebase.db) throw new Error('Firebase not initialized');

        // Fast parallel reads
        const [modelsRaw, filamentsRaw, ordersRaw] = await Promise.all([
          readCollection(COL_MODELS),
          readCollection(COL_FILAMENTS),
          readCollection(COL_ORDERS)
        ]);

        if (modelsRaw.length > 0) {
          catalogModels = modelsRaw.map(normalizeModel);
        } else {
          // Seed defaults
          loadDefaultInMemoryData();
          await bulkWrite(COL_MODELS, catalogModels.map(m => ({ ...m })), m => m.id);
        }

        if (filamentsRaw.length > 0) {
          filaments = filamentsRaw.map(normalizeFilament).sort((a, b) => (a.sortOrder - b.sortOrder) || a.name.localeCompare(b.name));
        } else {
          if (filaments.length === 0) loadDefaultInMemoryData();
          await bulkWrite(COL_FILAMENTS, filaments.map(f => ({ ...f })), f => f.id);
        }

        if (ordersRaw.length > 0) {
          orders = ordersRaw.map(normalizeOrder);
        }

        if (!selectedFilamentId && filaments.length > 0) selectedFilamentId = filaments[0].id;
        rebuildMaps();
        renderCategoryPills();
        renderShopGrid();
        hideLoading();
        handleHashNavigation();
        setSyncPill('ok', 'Synced');

        // Set up realtime listeners
        setupRealtimeListeners();

      } catch (err) {
        setSyncPill('err', 'Error');
        showLoadingError('Firebase', 'INIT_FAILED', err.message || 'Failed to connect to Firebase.');
      }
    }

    // Realtime listeners — Firebase pushes updates instantly, no polling
    function setupRealtimeListeners() {
      try {
        firebase.onSnapshot(firebase.collection(firebase.db, COL_MODELS), (snap) => {
          const arr = []; snap.forEach(d => arr.push(d.data()));
          catalogModels = arr.map(normalizeModel);
          rebuildMaps();
          renderCategoryPills();
          renderShopGrid();
          if (activeView === 'owner') renderOwnerCatalog();
        });

        firebase.onSnapshot(firebase.collection(firebase.db, COL_FILAMENTS), (snap) => {
          const arr = []; snap.forEach(d => arr.push(d.data()));
          filaments = arr.map(normalizeFilament).sort((a, b) => (a.sortOrder - b.sortOrder) || a.name.localeCompare(b.name));
          rebuildMaps();
          if (activeView === 'owner') renderOwnerFilaments();
          if (!selectedFilamentId && filaments.length > 0) selectedFilamentId = filaments[0].id;
        });

        firebase.onSnapshot(firebase.collection(firebase.db, COL_ORDERS), (snap) => {
          const arr = []; snap.forEach(d => arr.push(d.data()));
          orders = arr.map(normalizeOrder);
          rebuildMaps();
          if (activeView === 'owner') renderOwnerPortal();
          if (activeView === 'tracking' && activeTrackingCode) viewOrderTracking(activeTrackingCode, false);
        });
      } catch (e) { console.warn('Realtime listener setup failed:', e); }
    }

    window.retryBackendConnection = function() { initBackend(); };

    // ============================================================
    // SYNC FUNCTIONS
    // ============================================================

    // CUSTOMER SYNC — download all, upload only MY orders
    window.customerSync = async function() {
      if (!firebase || !firebase.db) { showToast('Offline — cannot sync.', 'error'); return; }
      if (syncState.active) { showToast('Sync already in progress...'); return; }

      setSyncPill('busy', 'Syncing');
      showSyncBanner('Syncing My Order', 'Uploading my orders & downloading latest shop data...');

      syncState.counts = {
        models:    { done: 0, total: 0, failed: 0, dir: 'pull' },
        filaments: { done: 0, total: 0, failed: 0, dir: 'pull' },
        orders:    { done: 0, total: 0, failed: 0, dir: 'push' }
      };
      renderSyncCounts();
      let totalFailed = 0;

      try {
        const arr = await readCollection(COL_MODELS);
        catalogModels = arr.map(normalizeModel);
        setSyncCounts('models', arr.length, arr.length, 0, 'pull');
      } catch (e) { syncState.counts.models.failed = 1; totalFailed++; setSyncCounts('models', 0, 1, 1, 'pull'); }

      try {
        const arr = await readCollection(COL_FILAMENTS);
        filaments = arr.map(normalizeFilament).sort((a, b) => (a.sortOrder - b.sortOrder) || a.name.localeCompare(b.name));
        setSyncCounts('filaments', arr.length, arr.length, 0, 'pull');
      } catch (e) { syncState.counts.filaments.failed = 1; totalFailed++; setSyncCounts('filaments', 0, 1, 1, 'pull'); }

      // Only push MY orders
      let mySet = new Set();
      try { mySet = new Set(JSON.parse(localStorage.getItem('jj_my_orders_v1') || '[]')); } catch(e) {}
      const myOrdersList = orders.filter(o => mySet.has(o.trackingCode));

      syncState.counts.orders.total = myOrdersList.length;
      renderSyncCounts();

      for (let i = 0; i < myOrdersList.length; i++) {
        try {
          await writeDoc(COL_ORDERS, myOrdersList[i].trackingCode, myOrdersList[i]);
          setSyncCounts('orders', i + 1, myOrdersList.length, syncState.counts.orders.failed, 'push');
        } catch (e) { syncState.counts.orders.failed++; totalFailed++; setSyncCounts('orders', i + 1, myOrdersList.length, syncState.counts.orders.failed, 'push'); }
      }

      rebuildMaps(); renderCategoryPills(); renderShopGrid();
      if (activeView === 'owner') renderOwnerPortal();
      if (activeView === 'tracking' && activeTrackingCode) viewOrderTracking(activeTrackingCode, false);

      if (totalFailed === 0) { setSyncPill('ok', 'Synced'); finalizeSyncBanner(true, 0, 'Order Synced'); }
      else { setSyncPill('failed', totalFailed + ' failed'); finalizeSyncBanner(false, totalFailed); showToast(totalFailed + ' item(s) failed to sync.', 'error'); }
    };

    // OWNER SYNC — full push using batched writes
    window.ownerSync = async function() {
      if (!firebase || !firebase.db) { showToast('Offline — cannot sync.', 'error'); return; }
      if (syncState.active) { showToast('Sync already in progress...'); return; }

      setSyncPill('busy', 'Syncing');
      showSyncBanner('Owner Sync', 'Pushing catalog, filaments & orders...');

      syncState.counts = {
        models:    { done: 0, total: catalogModels.length, failed: 0, dir: 'push' },
        filaments: { done: 0, total: filaments.length, failed: 0, dir: 'push' },
        orders:    { done: 0, total: orders.length, failed: 0, dir: 'push' }
      };
      renderSyncCounts();
      let totalFailed = 0;

      try {
        await bulkWrite(COL_MODELS, catalogModels.map(m => ({ ...m })), m => m.id);
        setSyncCounts('models', catalogModels.length, catalogModels.length, 0, 'push');
      } catch (e) { syncState.counts.models.failed = catalogModels.length || 1; totalFailed++; setSyncCounts('models', 0, catalogModels.length, syncState.counts.models.failed, 'push'); }

      try {
        await bulkWrite(COL_FILAMENTS, filaments.map(f => ({ ...f })), f => f.id);
        setSyncCounts('filaments', filaments.length, filaments.length, 0, 'push');
      } catch (e) { syncState.counts.filaments.failed = filaments.length || 1; totalFailed++; setSyncCounts('filaments', 0, filaments.length, syncState.counts.filaments.failed, 'push'); }

      try {
        await bulkWrite(COL_ORDERS, orders.map(o => ({ ...o })), o => o.trackingCode);
        setSyncCounts('orders', orders.length, orders.length, 0, 'push');
      } catch (e) { syncState.counts.orders.failed = orders.length || 1; totalFailed++; setSyncCounts('orders', 0, orders.length, syncState.counts.orders.failed, 'push'); }

      if (totalFailed === 0) { setSyncPill('ok', 'Synced'); finalizeSyncBanner(true, 0, 'Owner Sync Complete'); showToast('Owner sync complete!'); }
      else { setSyncPill('failed', totalFailed + ' failed'); finalizeSyncBanner(false, totalFailed); showToast(totalFailed + ' item(s) failed to sync.', 'error'); }
    };

    // DB write helpers
    window.saveModelToDb = async function(model) {
      if (!firebase || !firebase.db) return;
      try { await writeDoc(COL_MODELS, model.id, { ...model }); } catch (e) { console.warn('Save model failed:', e); }
    };
    window.removeModelFromDb = async function(id) {
      if (!firebase || !firebase.db) return;
      try { await deleteDocById(COL_MODELS, id); } catch (e) { console.warn('Delete model failed:', e); }
    };
    window.saveFilamentToDb = async function(filament) {
      if (!firebase || !firebase.db) return;
      try { await writeDoc(COL_FILAMENTS, filament.id, { ...filament }); } catch (e) { console.warn('Save filament failed:', e); }
    };
    window.removeFilamentFromDb = async function(id) {
      if (!firebase || !firebase.db) return;
      try { await deleteDocById(COL_FILAMENTS, id); } catch (e) { console.warn('Delete filament failed:', e); }
    };
    window.saveOrderToDb = async function(order) {
      if (!firebase || !firebase.db) return;
      try { await writeDoc(COL_ORDERS, order.trackingCode, { ...order }); } catch (e) { console.warn('Save order failed:', e); }
    };
    window.removeOrderFromDb = async function(code) {
      if (!firebase || !firebase.db) return;
      try { await deleteDocById(COL_ORDERS, code); } catch (e) { console.warn('Delete order failed:', e); }
    };

    // ============================================================
    // WIPE & RESET
    // ============================================================
    window.openWipeModal = function() {
      document.getElementById('wipe-confirm-input').value = '';
      document.getElementById('modal-wipe').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => document.getElementById('wipe-confirm-input').focus(), 100);
    };
    window.closeWipeModal = function() {
      document.getElementById('modal-wipe').classList.add('hidden');
      document.body.style.overflow = '';
    };
    window.executeWipe = async function() {
      const typed = document.getElementById('wipe-confirm-input').value.trim();
      const phrase = 'i want to delete all my progress and restart from beginning!';
      if (typed !== phrase) {
        showToast('Text does not match exactly. Please type it exactly as shown.', 'error');
        return;
      }
      if (!firebase || !firebase.db) { showToast('Firebase not ready.', 'error'); return; }

      closeWipeModal();
      showSyncBanner('Wiping Everything', 'Deleting all models, filaments & orders...');
      syncState.active = true;

      try {
        // Get all IDs
        const [modelsSnap, filamentsSnap, ordersSnap] = await Promise.all([
          firebase.getDocs(firebase.collection(firebase.db, COL_MODELS)),
          firebase.getDocs(firebase.collection(firebase.db, COL_FILAMENTS)),
          firebase.getDocs(firebase.collection(firebase.db, COL_ORDERS))
        ]);
        const modelIds = []; modelsSnap.forEach(d => modelIds.push(d.id));
        const filamentIds = []; filamentsSnap.forEach(d => filamentIds.push(d.id));
        const orderIds = []; ordersSnap.forEach(d => orderIds.push(d.id));

        await Promise.all([
          bulkDelete(COL_MODELS, modelIds),
          bulkDelete(COL_FILAMENTS, filamentIds),
          bulkDelete(COL_ORDERS, orderIds)
        ]);

        // Upload defaults
        const defaultModels = getDefaultModels();
        const defaultFilaments = getDefaultFilaments();
        const defaultOrders = getDefaultOrders();

        await bulkWrite(COL_MODELS, defaultModels, m => m.id);
        await bulkWrite(COL_FILAMENTS, defaultFilaments, f => f.id);
        await bulkWrite(COL_ORDERS, defaultOrders, o => o.trackingCode);

        // Update local state
        catalogModels = defaultModels;
        filaments = defaultFilaments;
        orders = defaultOrders;
        cart = [];
        saveCart();
        updateCartBadge();
        localStorage.removeItem('jj_my_orders_v1');
